list navigation-bar (
    name: Navigation Bar

    entry new-request (
        label: New request
        icon {
            imageIconCssClasses: fa-plus
        }
        layout {
            sequence: 3
        }
        link {
            target: {
                page: 210
                clearCache: 210
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry active-environment (
        label: Environment: &ARW_ENV_NAME.
        icon {
            imageIconCssClasses: fa-globe
        }
        layout {
            sequence: 5
        }
        link {
            target: {
                page: 300
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry --- (
        label: ---
        layout {
            sequence: 20
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: separator
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

    entry app-user (
        label: &APP_USER.
        icon {
            imageIconCssClasses: fa-user
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                type: url
                url: #
            }
        }
        userDefinedAttributes {
            2: has-username
        }
    )

    entry sign-out (
        label: Sign Out
        icon {
            imageIconCssClasses: fa-sign-out
        }
        layout {
            sequence: 30
            parentEntry: @app-user
        }
        link {
            target: {
                type: url
                url: &LOGOUT_URL.
            }
        }
        serverSideCondition {
            type: userIsAuthenticated
        }
    )

)

list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        isCurrent {
            type: pages
            pages: [
                1
            ]
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry collections (
        label: Collections
        icon {
            imageIconCssClasses: fa-folder-open
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: [
                100
                110
                200
                210
                215
            ]
        }
        link {
            target: {
                page: 100
            }
        }
    )

    entry environments (
        label: Environments
        icon {
            imageIconCssClasses: fa-server
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: [
                300
                310
            ]
        }
        link {
            target: {
                page: 300
            }
        }
    )

    entry history (
        label: History
        icon {
            imageIconCssClasses: fa-history
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: [
                400
                410
            ]
        }
        link {
            target: {
                page: 400
            }
        }
    )

    entry target-profiles (
        label: Target profiles
        icon {
            imageIconCssClasses: fa-sliders
        }
        layout {
            sequence: 50
        }
        isCurrent {
            type: pages
            pages: [
                500
                510
            ]
        }
        link {
            target: {
                page: 500
            }
        }
    )

    entry import (
        label: Import
        icon {
            imageIconCssClasses: fa-upload
        }
        layout {
            sequence: 60
        }
        isCurrent {
            type: pages
            pages: [
                700
            ]
        }
        link {
            target: {
                page: 700
            }
        }
    )

    entry preflight (
        label: Preflight
        icon {
            imageIconCssClasses: fa-check-circle-o
        }
        layout {
            sequence: 70
        }
        isCurrent {
            type: pages
            pages: [
                800
                600
                610
            ]
        }
        link {
            target: {
                page: 800
            }
        }
    )

)
