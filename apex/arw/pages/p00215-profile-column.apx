page 215 (
    name: Profile Column
    alias: PROFILE-COLUMN
    title: Profile column
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Edit one column of the derived data profile -- name, inferred type, length, format mask, nullability and primary key. Any edit sets the profile back to an editable proposal until it is accepted again.
    }

    region columnForm (
        name: Profile Column
        type: form
        source {
            location: localDatabase
            tableName: ARW_PROFILE_COLUMNS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    region buttonsSR (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P215_COLUMN_ID (
        type: hidden
        layout {
            sequence: 10
            region: @columnForm
            slot: regionBody
        }
        source {
            formRegion: @columnForm
            column: COLUMN_ID
            dataType: number
            queryOnly: true
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P215_PATH_EXPRESSION (
        type: displayOnly
        label {
            label: Path
            alignment: left
        }
        layout {
            sequence: 20
            region: @columnForm
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        settings {
            sendOnPageSubmit: false
            format: plainText
        }
        source {
            formRegion: @columnForm
            column: PATH_EXPRESSION
            dataType: varchar2
        }
    )

    pageItem P215_COLUMN_NAME (
        type: textField
        label {
            label: Column
            alignment: left
        }
        layout {
            sequence: 30
            region: @columnForm
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 128
        }
        source {
            formRegion: @columnForm
            column: COLUMN_NAME
            dataType: varchar2
        }
        help {
            inlineHelpText: Target column name used by the generated json_table and DDL
        }
    )

    pageItem P215_DATA_TYPE_CODE (
        type: selectList
        label {
            label: Inferred Type
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select arw_discover_api.data_type_label(
                           p_data_type_code => t.column_value
                       )                                                   as display_value
                     , t.column_value                                      as return_value
                  from table(sys.odcivarchar2list(
                           'varchar2'
                         , 'number'
                         , 'date'
                         , 'timestamp_with_time_zone'
                         , 'boolean'
                         , 'clob'
                       )) t
                ```
            displayExtraValues: false
            displayNullValue: false
        }
        layout {
            sequence: 40
            region: @columnForm
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @columnForm
            column: DATA_TYPE_CODE
            dataType: varchar2
        }
    )

    pageItem P215_MAX_OBSERVED_LENGTH (
        type: numberField
        label {
            label: Length
            alignment: left
        }
        layout {
            sequence: 50
            region: @columnForm
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 10
        }
        source {
            formRegion: @columnForm
            column: MAX_OBSERVED_LENGTH
            dataType: number
        }
        help {
            inlineHelpText: Longest value observed in the samples -- leave empty for non-text types
        }
    )

    pageItem P215_FORMAT_MASK (
        type: textField
        label {
            label: Format Mask
            alignment: left
        }
        layout {
            sequence: 60
            region: @columnForm
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @columnForm
            column: FORMAT_MASK
            dataType: varchar2
        }
        help {
            inlineHelpText: Only for date and timestamp columns
        }
    )

    pageItem P215_IS_NULLABLE_YN (
        type: switch
        label {
            label: Nullable
            alignment: left
        }
        layout {
            sequence: 70
            region: @columnForm
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @columnForm
            column: IS_NULLABLE_YN
            dataType: varchar2
        }
    )

    pageItem P215_IS_PRIMARY_KEY_YN (
        type: switch
        label {
            label: Primary Key
            alignment: left
        }
        layout {
            sequence: 80
            region: @columnForm
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @columnForm
            column: IS_PRIMARY_KEY_YN
            dataType: varchar2
        }
        help {
            inlineHelpText: At most one column of the profile is the primary key
        }
    )

    button CANCEL (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttonsSR
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button SAVE (
        buttonName: SAVE
        label: Save
        layout {
            sequence: 20
            region: @buttonsSR
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P215_COLUMN_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @CANCEL
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-column-form (
        name: Initialize Column Form
        type: formInitialization
        formRegion: @columnForm
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process save-column (
        name: Save Column
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_discover_api.update_column(
                    p_column_id                     => :P215_COLUMN_ID
                  , p_column_name                   => :P215_COLUMN_NAME
                  , p_data_type_code                => :P215_DATA_TYPE_CODE
                  , p_max_observed_length           => :P215_MAX_OBSERVED_LENGTH
                  , p_format_mask                   => :P215_FORMAT_MASK
                  , p_is_nullable_yn                => :P215_IS_NULLABLE_YN
                  , p_is_primary_key_yn             => :P215_IS_PRIMARY_KEY_YN
                );
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Column saved.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'SAVE'
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'SAVE'
                ```
        }
    )

)
