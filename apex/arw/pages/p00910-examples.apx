page 910 (
    name: Examples
    alias: EXAMPLES
    title: Examples
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Ready-to-send requests against jsonplaceholder.typicode.com, a free fake REST API. Click a card, press Send. They live in the Guide examples collection; Reset examples puts them back as they were.
    }

    region examplesHeadSR (
        advanced {
            htmlDomId: examplesHeadSR
        }
        name: Examples Header
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="arw-page-head">
                  <h1 class="arw-page-title">Examples</h1>
                </div>
                <p class="arw-muted">Click a card, then press Send.</p>
                ```
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region basicsCR (
        advanced {
            htmlDomId: basicsCR
        }
        name: Basics
        title: Basics
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.guide_example_id                                  as guide_example_id
                     , g.title                                             as title
                     , g.summary                                           as summary
                     , s.endpoint_id                                       as endpoint_id
                     , s.http_method                                       as http_method
                     , s.display_url                                       as display_url
                  from arw_guide_examples                  g
                  join arw_endpoint_summary_vw             s on s.endpoint_id = g.endpoint_id
                 where g.category_code = 'basics'
                   and g.active_yn = 'Y'
                 order by g.display_seq
                ```
        }
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        card {
            primaryKeyColumn1: GUIDE_EXAMPLE_ID
        }
        title {
            advancedFormatting: false
            column: TITLE
        }
        subtitle {
            advancedFormatting: true
            htmlExpression:
                ```html
                <span class="arw-chip arw-chip--method">&HTTP_METHOD.</span> <span class="arw-mono">&DISPLAY_URL.</span>
                ```
        }
        body {
            advancedFormatting: false
            column: SUMMARY
        }
        componentAppearance {
            layout: grid
            gridColumns: 2
        }
        messages {
            whenNoDataFound: No examples yet -- press Reset examples.
        }

        action open-example (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 210
                    items: {
                        P210_ENDPOINT_ID: &ENDPOINT_ID.
                    }
                    clearCache: 210
                }
            }
        )
    )

    region sendingDataCR (
        advanced {
            htmlDomId: sendingDataCR
        }
        name: Sending data
        title: Sending data
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select g.guide_example_id                                  as guide_example_id
                     , g.title                                             as title
                     , g.summary                                           as summary
                     , s.endpoint_id                                       as endpoint_id
                     , s.http_method                                       as http_method
                     , s.display_url                                       as display_url
                  from arw_guide_examples                  g
                  join arw_endpoint_summary_vw             s on s.endpoint_id = g.endpoint_id
                 where g.category_code = 'sending_data'
                   and g.active_yn = 'Y'
                 order by g.display_seq
                ```
        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        card {
            primaryKeyColumn1: GUIDE_EXAMPLE_ID
        }
        title {
            advancedFormatting: false
            column: TITLE
        }
        subtitle {
            advancedFormatting: true
            htmlExpression:
                ```html
                <span class="arw-chip arw-chip--method">&HTTP_METHOD.</span> <span class="arw-mono">&DISPLAY_URL.</span>
                ```
        }
        body {
            advancedFormatting: false
            column: SUMMARY
        }
        componentAppearance {
            layout: grid
            gridColumns: 2
        }
        messages {
            whenNoDataFound: No examples yet -- press Reset examples.
        }

        action open-example (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 210
                    items: {
                        P210_ENDPOINT_ID: &ENDPOINT_ID.
                    }
                    clearCache: 210
                }
            }
        )
    )

    region variablesCR (
        advanced {
            htmlDomId: variablesCR
