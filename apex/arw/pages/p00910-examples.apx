                select w.guide_example_id                                  as guide_example_id
                     , w.title                                             as title
                     , w.summary                                           as summary
                     , w.endpoint_id                                       as endpoint_id
                     , w.http_method                                       as http_method
                     , w.display_url                                       as display_url
                     , case
                         when gr.guide_example_id is null then 'Needs ACL'
