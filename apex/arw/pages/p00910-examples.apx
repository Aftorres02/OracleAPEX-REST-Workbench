        }
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        card {
            primaryKeyColumn1: GUIDE_EXAMPLE_ID
        }
        title {
            advancedFormatting: false
            column: TITLE
        }
        subtitle {
            advancedFormatting: true
            htmlExpression:
                ```html
                <span class="arw-chip arw-chip--method">&HTTP_METHOD.</span> <span class="arw-mono">&DISPLAY_URL.</span>
                ```
        }
        body {
            advancedFormatting: false
            column: SUMMARY
        }
        iconAndBadge {
            badgeColumn: ACL_BADGE
        }
        componentAppearance {
            layout: grid
            gridColumns: 3
        }
        messages {
            whenNoDataFound: No examples yet -- press Reset examples.
        }

        action open-example (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 210
                    items: {
                        P210_ENDPOINT_ID: &ENDPOINT_ID.
                    }
                    clearCache: 210
                }
            }
        )
    )

