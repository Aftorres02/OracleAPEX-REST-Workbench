    button RESET_EXAMPLES (
        buttonName: RESET_EXAMPLES
        advanced {
            htmlDomId: RESET_EXAMPLES
        }
        label: Reset examples
        layout {
            sequence: 10
            region: @examplesHeadSR
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Put every example back as it was? Your changes to them are lost.
            style: warning
        }
    )

    process reset-examples (
        name: Reset Examples
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_guide_api.install_examples;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Examples restored.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'RESET_EXAMPLES'
                ```
        }
    )

    branch back-to-examples (
        name: Back To Examples
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 910
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'RESET_EXAMPLES'
                ```
        }
    )

)
