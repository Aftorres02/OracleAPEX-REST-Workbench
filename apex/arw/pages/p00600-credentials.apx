page 600 (
    name: Credentials
    alias: CREDENTIALS
    title: Credentials
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Credential metadata used by endpoints. Secrets never live in ARW tables -- they are stored in an APEX Web Credential referenced by its static ID. The Web Credential column shows whether that APEX credential exists in this workspace.
    }

    region credentialsHeadSR (
        name: Credentials Header
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="arw-page-head">
                  <div>
                    <h1 class="arw-page-title">Credentials</h1>
                    <p class="arw-page-subtitle">secrets stay in APEX Web Credentials</p>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region credentialsIR (
        name: Credentials
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_cred as (
                  select c.credential_id                                     as credential_id
                       , c.name                                              as name
                       , c.auth_type_code                                    as auth_type_code
                       , c.apex_credential_static_id                         as apex_credential_static_id
                       , case
                           when c.apex_credential_static_id is not null
                             then arw_credentials_api.web_credential_exists(
                                      p_static_id => c.apex_credential_static_id
                                  )
                         end                                                 as web_credential_exists_yn
                    from arw_credentials c
                   where c.active_yn = 'Y'
                )
                select w.credential_id                                     as credential_id
                     , w.name                                              as name
                     , w.auth_type_code                                    as auth_type_code
                     , w.apex_credential_static_id                         as apex_credential_static_id
                     , w.web_credential_exists_yn                          as web_credential_exists_yn
                     , case w.web_credential_exists_yn
                         when 'Y' then 'exists'
                         when 'N' then 'missing'
                         when '?' then 'unknown'
                         else 'no static ID'
                       end                                                 as web_credential_label
                     , case w.web_credential_exists_yn
                         when 'Y' then 'ok'
                         when 'N' then 'error'
                       end                                                 as web_credential_class
                  from w_cred w
                 order by w.name
                ```
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 610
                items: {
                    P610_CREDENTIAL_ID: #CREDENTIAL_ID#
                }
                clearCache: 610
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit credential"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: No credentials yet.
        }

        column CREDENTIAL_ID (
            type: hidden
            heading {
                heading: Credential Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column AUTH_TYPE_CODE (
            type: plainText
            heading {
                heading: Auth Type
            }
            layout {
                sequence: 30
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="arw-chip arw-chip--mono">#AUTH_TYPE_CODE#</span>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column APEX_CREDENTIAL_STATIC_ID (
            type: plainText
            heading {
                heading: Web Credential Static ID
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="arw-mono">#APEX_CREDENTIAL_STATIC_ID#</span>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column WEB_CREDENTIAL_EXISTS_YN (
            type: hidden
            heading {
                heading: Web Credential Exists
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )

        column WEB_CREDENTIAL_LABEL (
            type: plainText
            heading {
                heading: Web Credential
                alignment: center
            }
            layout {
                sequence: 60
                columnAlignment: center
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <span class="arw-chip arw-chip--#WEB_CREDENTIAL_CLASS#">#WEB_CREDENTIAL_LABEL#</span>
                    ```
            }
            source {
                dataType: STRING
            }
        )

        column WEB_CREDENTIAL_CLASS (
            type: hidden
            heading {
                heading: Web Credential Class
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )

    )

    button CREATE (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @credentialsIR
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 610
                clearCache: 610
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-on-dialog-close (
        name: Refresh on Dialog Close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @credentialsIR
        }

        action refresh-credentials (
            action: refresh
            affectedElements {
                selectionType: region
                region: @credentialsIR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
