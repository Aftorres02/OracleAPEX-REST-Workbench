page 800 (
    name: Preflight
    alias: PREFLIGHT
    title: Environment preflight
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Checks everything an outbound call from the database needs for one host -- network ACL, wallet/TLS chain, database and APEX version, and the Web Credential -- before anything is executed. A failing check blocks executions; copy its script and run it as ADMIN, then press Re-check.
    }

    region preflightFilterSR (
        advanced {
            htmlDomId: preflightFilterSR
        }
        name: Preflight Filters
        type: staticContent
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region preflightSR (
        advanced {
            htmlDomId: preflightSR
        }
        name: Preflight
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                arw-panel
                arw-panel--flush
            ]
        }
    )

    region preflightHeadCR (
        advanced {
            htmlDomId: preflightHeadCR
        }
        name: Preflight Header
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_checks as (
                  select r.status_code                                       as status_code
                    from table(arw_preflight_api.preflight_report(
                             p_host          => :P800_HOST
                           , p_credential_id => :P800_CREDENTIAL_ID
                         )) r
                )
                select :P800_HOST                                          as host
                     , count(case when c.status_code = 'fail' then 1 end)  as blocking_count
                     , count(1)                                            as total_count
                  from w_checks c
                ```
            pageItemsToSubmit: [
                P800_HOST
                P800_CREDENTIAL_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @preflightSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                arw-detail
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        heading {
            type: none
        }
        pagination {
            type: rowRangesXToYNoPagination
        }

        column HOST (
            type: plainText
            heading {
                heading: Host
                alignment: start
            }
            layout {
                sequence: 10
                columnAlignment: start
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="arw-preflight-head">
                      <div>
                        <h1 class="arw-page-title">Environment preflight</h1>
                        <p class="arw-page-subtitle">host: {if HOST/}#HOST#{endif/}{if !HOST/}none -- create an environment first{endif/}</p>
                      </div>
                      {if HOST/}{if BLOCKING_COUNT/}<span class="arw-chip arw-chip--error">#BLOCKING_COUNT# of #TOTAL_COUNT# blocking</span>{endif/}{if !BLOCKING_COUNT/}<span class="arw-chip arw-chip--ok">All checks passed</span>{endif/}{endif/}
                    </div>
                    ```
            }
            advanced {
                computeSum: false
            }
        )

        column BLOCKING_COUNT (
            type: hidden
            layout {
                sequence: 20
            }
        )

        column TOTAL_COUNT (
            type: hidden
            layout {
                sequence: 30
            }
        )

    )

    region preflightChecksCR (
        advanced {
            htmlDomId: preflightChecksCR
        }
        name: Preflight Checks
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_cred as (
                  select max(c.apex_credential_static_id)                    as static_id
                    from arw_credentials c
                   where c.credential_id = :P800_CREDENTIAL_ID
                )
                select r.check_name                                        as check_name
                     , r.check_title                                       as check_title
                     , r.status_code                                       as status_code
                     , r.check_message                                     as check_message
                     , r.corrective_action                                 as corrective_action
                     , case
                         when r.check_name = 'credential_exists'
                          and r.status_code in ('warn', 'fail')
                          and :P800_CREDENTIAL_ID is not null
                           then apex_page.get_url(
                                    p_page        => 610
                                  , p_clear_cache => '610'
                                  , p_items       => 'P610_CREDENTIAL_ID,P610_STATIC_ID'
                                  , p_values      => :P800_CREDENTIAL_ID || ',' || w.static_id
                                )
                       end                                                 as create_credential_url
                  from table(arw_preflight_api.preflight_report(
                           p_host          => :P800_HOST
                         , p_credential_id => :P800_CREDENTIAL_ID
                       ))                                  r
                 cross join w_cred                         w
                ```
            pageItemsToSubmit: [
                P800_HOST
                P800_CREDENTIAL_ID
            ]
        }
        layout {
            sequence: 20
            parentRegion: @preflightSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                arw-checks
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
            ]
        }
        heading {
            type: none
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: Pick a host to run the preflight checks.
        }

        column CHECK_NAME (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column CHECK_TITLE (
            type: plainText
            heading {
                heading: Check
                alignment: start
            }
            layout {
                sequence: 20
                columnAlignment: start
            }
            columnFormatting {
                htmlExpression:
                    ```html
                    <div class="arw-check" data-check="#CHECK_NAME#">
                      <span class="arw-check__icon arw-check__icon--#STATUS_CODE#" role="img" aria-label="#STATUS_CODE#"></span>
                      <div class="arw-check__body">
                        <div class="arw-check__title">#CHECK_TITLE#</div>
                        <div class="arw-check__message">#CHECK_MESSAGE#</div>
                        {if CORRECTIVE_ACTION/}<pre class="arw-code">#CORRECTIVE_ACTION#</pre>
                        <div class="arw-check__actions"><button type="button" class="t-Button arw-copy-script">Copy script</button><button type="button" class="t-Button arw-recheck">Re-check</button></div>{endif/}
                        {if CREATE_CREDENTIAL_URL/}<div class="arw-check__actions"><a class="t-Button" href="#CREATE_CREDENTIAL_URL#">Create credential</a></div>{endif/}
                      </div>
                    </div>
                    ```
            }
            advanced {
                computeSum: false
            }
        )

        column STATUS_CODE (
            type: hidden
            layout {
                sequence: 30
            }
        )

        column CHECK_MESSAGE (
            type: hidden
            layout {
                sequence: 40
            }
        )

        column CORRECTIVE_ACTION (
            type: hidden
            layout {
                sequence: 50
            }
        )

        column CREATE_CREDENTIAL_URL (
            type: hidden
            layout {
                sequence: 60
            }
        )

    )

    pageItem P800_HOST (
        type: selectList
        label {
            label: Host
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_hosts as (
                  select distinct arw_preflight_api.host_of(p_url => e.base_url) as host
                    from arw_environments e
                   where e.active_yn = 'Y'
                )
                select h.host                                              as display_value
                     , h.host                                              as return_value
                  from w_hosts h
                 where h.host is not null
                 order by h.host
                ```
            displayNullValue: false
        }
        layout {
            sequence: 10
            region: @preflightFilterSR
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue:
                ```sql
                select min(arw_preflight_api.host_of(p_url => e.base_url)) as host
                  from arw_environments e
                 where e.active_yn = 'Y'
                ```
        }
        help {
            inlineHelpText: Hosts of the active environments' base URLs
        }
    )

    pageItem P800_CREDENTIAL_ID (
        type: selectList
        label {
            label: Credential
            alignment: left
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.name || nvl2(c.apex_credential_static_id, ' (' || c.apex_credential_static_id || ')', null) as display_value
                     , c.credential_id                                     as return_value
                  from arw_credentials c
                 where c.active_yn = 'Y'
                 order by c.name
                ```
            displayNullValue: true
            nullDisplayValue: - No credential -
        }
        layout {
            sequence: 20
            region: @preflightFilterSR
            slot: regionBody
            alignment: left
            startNewRow: false
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
    )

    button CREDENTIALS (
        buttonName: CREDENTIALS
        advanced {
            htmlDomId: CREDENTIALS
        }
        label: Credentials
        layout {
            sequence: 10
            region: @preflightFilterSR
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 600
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction recheck-on-filter-change (
        name: Re-check on Filter Change
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: [
                P800_HOST
                P800_CREDENTIAL_ID
            ]
        }

        action refresh-head (
            action: refresh
            affectedElements {
                selectionType: region
                region: @preflightHeadCR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-checks (
            action: refresh
            affectedElements {
                selectionType: region
                region: @preflightChecksCR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction recheck-on-click (
        name: Re-check on Click
        execution {
            sequence: 20
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .arw-recheck
        }

        action refresh-head (
            action: refresh
            affectedElements {
                selectionType: region
                region: @preflightHeadCR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-checks (
            action: refresh
            affectedElements {
                selectionType: region
                region: @preflightChecksCR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction copy-script (
        name: Copy Script
        execution {
            sequence: 30
            eventScope: dynamic
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .arw-copy-script
        }

        action copy-script-to-clipboard (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    var lScript = apex.jQuery(this.triggeringElement).closest('.arw-check').find('.arw-code').text();
                    navigator.clipboard.writeText(lScript).then(
                      function() {
                        apex.message.showPageSuccess('Script copied to the clipboard.');
                      },
                      function() {
                        apex.message.showErrors([{
                            type: 'error'
                          , location: 'page'
                          , message: 'Could not copy the script -- select it and copy it manually.'
                        }]);
                      }
                    );
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    dynamicAction recheck-after-credential (
        name: Re-check After Credential Dialog
        execution {
            sequence: 40
        }
        when {
            event: apexafterclosedialog
            selectionType: jQuerySelector
            jquerySelector: body
        }

        action refresh-head (
            action: refresh
            affectedElements {
                selectionType: region
                region: @preflightHeadCR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-checks (
            action: refresh
            affectedElements {
                selectionType: region
                region: @preflightChecksCR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

)
