page 100 (
    name: Collections
    alias: COLLECTIONS
    title: Collections
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Lists every active collection -- the top-level grouping for environments and endpoints, same idea as a Postman collection. Click a collection name to open its endpoints; use the edit icon to rename or delete it.
    }

    region collectionsHeadSR (
        name: Collections Header
        type: staticContent
        source {
            htmlCode:
                ```html
                <div class="arw-page-head">
                  <div>
                    <h1 class="arw-page-title">Collections</h1>
                    <p class="arw-page-subtitle">endpoints grouped like a Postman collection</p>
                  </div>
                  <span class="arw-chip arw-chip--info">Active environment: &ARW_ENV_NAME.</span>
                </div>
                ```
        }
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region collectionsIR (
        name: Collections
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.collection_id                                     as collection_id
                     , s.name                                              as name
                     , s.description                                       as description
                     , p.name                                              as parent_name
                     , s.endpoint_count                                    as endpoint_count
                     , s.profiled_count                                    as profiled_count
                  from arw_collection_summary_vw           s
                  left join arw_collections                  p on p.collection_id = s.parent_collection_id
                ```
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 110
                items: {
                    P110_COLLECTION_ID: #COLLECTION_ID#
                }
                clearCache: 110
            }
            linkIcon: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit collection"></span>
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 100000
        }
        messages {
            whenNoDataFound: No collections found.
        }

        column COLLECTION_ID (
            type: hidden
            heading {
                heading: Collection Id
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
        )

        column NAME (
            type: link
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            link {
                target: {
                    page: 200
                    items: {
                        P200_COLLECTION_ID: #COLLECTION_ID#
                    }
                    clearCache: 200
                }
                linkText: #NAME#
                linkAttributes: title="Open the endpoints of this collection"
            }
            source {
                dataType: STRING
            }
        )

        column DESCRIPTION (
            type: plainText
            heading {
                heading: Description
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column PARENT_NAME (
            type: plainText
            heading {
                heading: Parent Collection
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )

        column ENDPOINT_COUNT (
            type: link
            heading {
                heading: Endpoints
                alignment: end
            }
            layout {
                sequence: 50
                columnAlignment: end
            }
            link {
                target: {
                    page: 200
                    items: {
                        P200_COLLECTION_ID: #COLLECTION_ID#
                    }
                    clearCache: 200
                }
                linkText: <span class="arw-chip arw-chip--info">#ENDPOINT_COUNT# endpoints</span>
                linkAttributes: title="Open the endpoints of this collection"
            }
            source {
                dataType: NUMBER
            }
        )

        column PROFILED_COUNT (
            type: plainText
            heading {
                heading: Profiled
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )

    )

    button CREATE (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @collectionsIR
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 110
                clearCache: 110
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button IMPORT (
        buttonName: IMPORT
        label: Import Postman
        layout {
            sequence: 20
            region: @collectionsIR
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 700
                clearCache: 700
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction refresh-on-dialog-close (
        name: Refresh on Dialog Close
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @collectionsIR
        }

        action refresh-collections (
            action: refresh
            affectedElements {
                selectionType: region
                region: @collectionsIR
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
