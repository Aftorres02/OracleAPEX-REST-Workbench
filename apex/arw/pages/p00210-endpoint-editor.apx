page 210 (
    name: Endpoint Editor
    alias: ENDPOINT-EDITOR
    title: Endpoint
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript
            /*
             * ==========================================================================
             * PAGE 210 -- ENDPOINT EDITOR
             * ==========================================================================
             *
             * @description Client helpers for the endpoint editor: error reporting for
             *              Send (page submit), the Auth tab fields and the Code-tab
             *              list highlight.
             * @author      ARW (agent D2)
             * @created     October 2026
             * @issue       PHASE1-25, PHASE2-simplified
             * @version     1.1
             */
            var arw = arw || {};

            arw.endpointEditor = (function(namespace, $, undefined) {
              'use strict';

              var MODULE_NAME = 'EndpointEditor';

              var CONFIG = {
                  ARTIFACT_SELECTOR: '#artifactListCR .arw-artifact'
                , ACTIVE_CLASS: 'is-active'
                , ERROR_ITEM: 'P210_ACTION_ERROR'
                , AUTH_TYPE_ITEM: 'P210_AUTH_TYPE_CODE'
                , AUTH_FIELDS: {
                      basic: ['P210_AUTH_USERNAME', 'P210_AUTH_PASSWORD']
                    , bearer: ['P210_AUTH_TOKEN']
                    , api_key: ['P210_AUTH_KEY_NAME', 'P210_AUTH_KEY_VALUE', 'P210_AUTH_KEY_LOCATION_CODE']
                  }
              };

              var _PREFIX = '[' + MODULE_NAME + ']';
              var logger = {
                  log:     function(msg, data) { console.log(_PREFIX, msg, data || ''); }
                , warning: function(msg, data) { console.warn(_PREFIX, msg, data || ''); }
                , error:   function(msg, data) { console.error(_PREFIX, msg, data || ''); }
              };

              /* ================================================================ */
              /* Private helpers                                                  */
              /* ================================================================ */

              /**
               * Show the error left by the last AJAX action, if any
               * @returns {boolean} - true when an error was shown
               */
              var _reportActionError = function() {
                var message = apex.item(CONFIG.ERROR_ITEM).getValue();
                if (!message) {
                  return false;
                }
                apex.message.clearErrors();
                apex.message.showErrors([{
                    type: 'error'
                  , location: 'page'
                  , message: message
                  , unsafe: true
                }]);
                logger.warning('Action failed', {message: message});
                return true;
              };

              /* ================================================================ */
              /* Public API                                                       */
              /* ================================================================ */

              /**
               * Show only the Auth tab fields of the selected auth type
               */
              var toggleAuthFields = function() {
                var authType = apex.item(CONFIG.AUTH_TYPE_ITEM).getValue();

                Object.keys(CONFIG.AUTH_FIELDS).forEach(function(type) {
                  CONFIG.AUTH_FIELDS[type].forEach(function(itemName) {
                    if (type === authType) {
                      apex.item(itemName).show();
                    } else {
                      apex.item(itemName).hide();
                    }
                  });
                });
              };

              /**
               * Mark one Code-tab list entry as the active one
               * @param {Element} element - The clicked .arw-artifact button
               */
              var markArtifactActive = function(element) {
                $(CONFIG.ARTIFACT_SELECTOR)
                  .removeClass(CONFIG.ACTIVE_CLASS)
                  .attr('aria-pressed', 'false');
                $(element)
                  .addClass(CONFIG.ACTIVE_CLASS)
                  .attr('aria-pressed', 'true');
              };

              /* ================================================================ */
              /* Return public API                                                */
              /* ================================================================ */
              return {
                  // Page load: error left by the last Send
                  reportActionError: _reportActionError

                  // Auth tab
                , toggleAuthFields: toggleAuthFields

                  // Code tab
                , markArtifactActive: markArtifactActive
              };

            })(arw, apex.jQuery);
            ```
        executeWhenPageLoads:
            ```javascript
            arw.endpointEditor.reportActionError();
            ```
    }
    css {
        inline:
            ```css
            /* Page 210 -- only what css/arw.css doesn't cover; layout stays native */
            .arw-body-template textarea {
              font-family: var(--a-base-font-family-monospace, monospace);
            }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Type or paste a URL and press Send -- Send saves the request (URL, Params, Auth, Headers, Body, Settings) and calls it from the database in one step; Save only saves. New requests without a collection go to Drafts; move them from the Settings tab. Below the request, the Response tab shows the result and the Code tab generates PL/SQL or a REST Data Source for it. The data profile (the response columns) is derived automatically from the last successful JSON response.
    }

    // =========================================================================
    // Editor card: top bar, request bar, tabs
    // =========================================================================

    region editorSR (
        advanced {
            htmlDomId: editorSR
        }
        name: Endpoint Editor
        type: staticContent
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                arw-editor
            ]
        }
    )

    region topbarCR (
        advanced {
            htmlDomId: topbarCR
        }
        name: Top Bar
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select apex_page.get_url(p_page => 100)                    as collections_url
                     , c.name                                              as collection_name
                     , apex_page.get_url(
                           p_page        => 200
                         , p_clear_cache => '200'
                         , p_items       => 'P200_COLLECTION_ID'
                         , p_values      => to_char(c.collection_id)
                       )                                                   as endpoints_url
                     , coalesce(e.name, 'New request')                     as endpoint_name
                     , coalesce(env.name, 'none')                          as environment_name
                  from dual                                d
                  left join arw_collections                c on c.collection_id = :P210_COLLECTION_ID
                                                            and c.active_yn = 'Y'
                  left join arw_endpoints                  e on e.endpoint_id = :P210_ENDPOINT_ID
                                                            and e.active_yn = 'Y'
                  left join arw_environments             env on env.environment_id = :P210_ENVIRONMENT_ID
                ```
            pageItemsToSubmit: [
                P210_COLLECTION_ID
                P210_ENDPOINT_ID
                P210_ENVIRONMENT_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @editorSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                arw-plain
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--noBorders
                t-Report--rowHighlightOff
            ]
        }
        heading {
            type: none
        }
        pagination {
            type: rowRangesXToYNoPagination
        }

        column COLLECTIONS_URL (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column COLLECTION_NAME (
            type: hidden
            layout {
                sequence: 20
            }
        )

        column ENDPOINTS_URL (
            type: hidden
            layout {
                sequence: 30
            }
        )

        column ENDPOINT_NAME (
            type: plainText
            heading {
                heading: Endpoint
            }
            layout {
                sequence: 40
            }
            columnFormatting {
                htmlExpression: <div class="arw-topbar"><nav class="arw-crumbs" aria-label="Breadcrumb"><a href="#COLLECTIONS_URL#">Collections</a><span class="arw-crumbs__sep" aria-hidden="true">&rsaquo;</span>{if COLLECTION_NAME/}<a href="#ENDPOINTS_URL#">#COLLECTION_NAME#</a>{endif/}{if !COLLECTION_NAME/}Drafts{endif/}<span class="arw-crumbs__sep" aria-hidden="true">&rsaquo;</span><span aria-current="page">#ENDPOINT_NAME#</span></nav></div>
            }
        )

        column ENVIRONMENT_NAME (
            type: hidden
            layout {
                sequence: 50
            }
        )

    )

    region requestSR (
        advanced {
            htmlDomId: requestSR
        }
        name: Request Bar
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @editorSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region requestBarCR (
        advanced {
            htmlDomId: requestBarCR
        }
        name: URL Preview
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_url as (
                  select e.http_method                                     as http_method
                       , arw_endpoint_api.display_url(
                             p_endpoint_id    => e.endpoint_id
                           , p_environment_id => :P210_ENVIRONMENT_ID
                         )                                                 as display_url
                       , arw_endpoint_api.display_url(
                             p_endpoint_id    => e.endpoint_id
                         )                                                 as template_url
                    from arw_endpoints e
                   where e.endpoint_id = :P210_ENDPOINT_ID
                     and e.active_yn = 'Y'
                )
                select u.http_method                                       as http_method
                     , u.display_url                                       as display_url
                     , case
                         when u.template_url != u.display_url
                         then u.template_url || ' -- environment ' || coalesce(:ARW_ENV_NAME, 'none')
                         when arw_endpoint_api.is_absolute_url_yn(p_url => u.display_url) = 'N'
                         then 'No environment in this collection: add one with a base_url, or enter the full URL'
                         else 'Full URL -- sent as written, no environment base'
                       end                                                 as url_note
                  from w_url u
                ```
            pageItemsToSubmit: [
                P210_ENDPOINT_ID
                P210_ENVIRONMENT_ID
            ]
        }
        layout {
            sequence: 25
            parentRegion: @editorSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                arw-plain
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--noBorders
                t-Report--rowHighlightOff
            ]
        }
        heading {
            type: none
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P210_ENDPOINT_ID
        }

        column HTTP_METHOD (
            type: hidden
            layout {
                sequence: 10
            }
        )

        column URL_NOTE (
            type: hidden
            layout {
                sequence: 30
            }
        )

        column DISPLAY_URL (
            type: plainText
            heading {
                heading: URL
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <div class="arw-muted arw-mono">&rarr; #DISPLAY_URL#<span class="arw-crumbs__sep" aria-hidden="true">&middot;</span>#URL_NOTE#</div>
            }
        )

    )

    region tabsSR (
        advanced {
            htmlDomId: tabsSR
        }
        name: Endpoint Tabs
        type: staticContent
        layout {
            sequence: 30
            parentRegion: @editorSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
                js-useLocalStorage
            ]
        }
    )

    // -------------------------------------------------------------------------
    // Tab: Settings (the endpoint form; Method / URL live in the request bar)
    // -------------------------------------------------------------------------

    region endpointForm (
        advanced {
            htmlDomId: endpointForm
        }
        name: Settings
        title: Settings
        type: form
        source {
            location: localDatabase
            tableName: ARW_ENDPOINTS
        }
        layout {
            sequence: 50
            parentRegion: @tabsSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
        }
    )

    // -------------------------------------------------------------------------
    // Tab: Auth
    // -------------------------------------------------------------------------

    region authSR (
        advanced {
            htmlDomId: authSR
        }
        name: Auth
        title: Auth
        type: staticContent
        layout {
            sequence: 20
            parentRegion: @tabsSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    // -------------------------------------------------------------------------
    // Tab: Headers
    // -------------------------------------------------------------------------

    region headersIG (
        advanced {
            htmlDomId: headersIG
        }
        name: Headers
        title: Headers
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select h.header_id                                         as header_id
                     , h.header_name                                       as header_name
                     , case
                         when h.is_sensitive_yn = 'Y' then '********'
                         else h.header_value
                       end                                                 as header_value
                     , h.is_sensitive_yn                                   as is_sensitive_yn
                  from arw_endpoint_headers h
                 where h.endpoint_id = :P210_ENDPOINT_ID
                   and h.active_yn = 'Y'
                 order by h.header_name
                ```
            pageItemsToSubmit: [
                P210_ENDPOINT_ID
            ]
        }
        layout {
            sequence: 30
            parentRegion: @tabsSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: No headers -- add one with Add Row; Send or Save stores it.
        }
        toolbar {
            controls: [
                searchField
                actionsMenu
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @HEADER_NAME
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @HEADER_VALUE
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @IS_SENSITIVE_YN
                layout {
                    sequence: 3
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 20
            }
        )

        column HEADER_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: HEADER_ID
                dataType: number
                primaryKey: true
            }
        )

        column HEADER_NAME (
            type: textField
            heading {
                heading: Header
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: HEADER_NAME
                dataType: varchar2
            }
        )

        column HEADER_VALUE (
            type: textField
            heading {
                heading: Value
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: HEADER_VALUE
                dataType: varchar2
            }
        )

        column IS_SENSITIVE_YN (
            type: switch
            heading {
                heading: Sensitive
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: IS_SENSITIVE_YN
                dataType: varchar2
            }
            default {
                type: static
                staticValue: N
            }
        )

    )

    // -------------------------------------------------------------------------
    // Tab: Params
    // -------------------------------------------------------------------------

    region paramsIG (
        advanced {
            htmlDomId: paramsIG
        }
        name: Params
        title: Params
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.param_id                                          as param_id
                     , p.param_kind_code                                   as param_kind_code
                     , p.param_name                                        as param_name
                     , p.param_value                                       as param_value
                     , p.data_type_code                                    as data_type_code
                     , p.is_required_yn                                    as is_required_yn
                  from arw_endpoint_params p
                 where p.endpoint_id = :P210_ENDPOINT_ID
                   and p.active_yn = 'Y'
                 order by p.param_kind_code
                        , p.param_name
                ```
            pageItemsToSubmit: [
                P210_ENDPOINT_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @tabsSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        messages {
            whenNoDataFound: No params -- add query, path or form params with Add Row; Send or Save stores them.
        }
        toolbar {
            controls: [
                searchField
                actionsMenu
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }

            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 0
                }
            )
            displayColumn (
                column: @PARAM_KIND_CODE
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @PARAM_NAME
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @PARAM_VALUE
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @DATA_TYPE_CODE
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @IS_REQUIRED_YN
                layout {
                    sequence: 5
                }
            )
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 20
            }
        )

        column PARAM_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: PARAM_ID
                dataType: number
                primaryKey: true
            }
        )

        column PARAM_KIND_CODE (
            type: selectList
            heading {
                heading: Kind
            }
            layout {
                sequence: 40
            }
            validation {
                valueRequired: true
            }
            lov {
                type: staticValues
                staticValues: STATIC2:query;query,path;path,form;form
                displayExtraValues: false
                displayNullValue: false
            }
            source {
                databaseColumn: PARAM_KIND_CODE
                dataType: varchar2
            }
            default {
                type: static
                staticValue: query
            }
        )

        column PARAM_NAME (
            type: textField
            heading {
                heading: Name
            }
            layout {
                sequence: 50
            }
            validation {
                valueRequired: true
                maxLength: 200
            }
            source {
                databaseColumn: PARAM_NAME
                dataType: varchar2
            }
        )

        column PARAM_VALUE (
            type: textField
            heading {
                heading: Value
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 4000
            }
            source {
                databaseColumn: PARAM_VALUE
                dataType: varchar2
            }
        )

        column DATA_TYPE_CODE (
            type: selectList
            heading {
                heading: Data Type
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
            }
            lov {
                type: staticValues
                staticValues: STATIC2:varchar2;varchar2,number;number,date;date,boolean;boolean
                displayExtraValues: false
                displayNullValue: false
            }
            source {
                databaseColumn: DATA_TYPE_CODE
                dataType: varchar2
            }
            default {
                type: static
                staticValue: varchar2
            }
        )

        column IS_REQUIRED_YN (
            type: switch
            heading {
                heading: Required
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: IS_REQUIRED_YN
                dataType: varchar2
            }
            default {
                type: static
                staticValue: N
            }
        )

    )

    // -------------------------------------------------------------------------
    // Tab: Body
    // -------------------------------------------------------------------------

    region bodySR (
        advanced {
            htmlDomId: bodySR
        }
        name: Body
        title: Body
        type: staticContent
        layout {
            sequence: 40
            parentRegion: @tabsSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    // -------------------------------------------------------------------------
    // Tab: Response (+ automatic data profile status)
    // -------------------------------------------------------------------------

    region responseTabsSR (
        advanced {
            htmlDomId: responseTabsSR
        }
        name: Result Tabs
        type: staticContent
        layout {
            sequence: 20
            slot: BODY
        }
        appearance {
            template: @/tabs-container
            templateOptions: [
                #DEFAULT#
                t-TabsRegion-mod--simple
            ]
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P210_ENDPOINT_ID
        }
    )

    region responseSR (
        advanced {
            htmlDomId: responseSR
        }
        name: Response
        title: Response
        type: staticContent
        layout {
            sequence: 10
            parentRegion: @responseTabsSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P210_ENDPOINT_ID
        }
    )

    region responseChipsCR (
        advanced {
            htmlDomId: responseChipsCR
        }
        name: Response Status
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select l.status_label                                      as status_label
                     , l.status_text                                       as status_text
                     , l.status_class                                      as status_class
                     , l.elapsed_ms                                        as elapsed_ms
                     , case
                         when l.response_size_bytes is null then null
                         when l.response_size_bytes < 1024
                         then l.response_size_bytes || ' B'
                         when l.response_size_bytes < 1048576
                         then to_char(l.response_size_bytes / 1024, 'fm999990.0') || ' KB'
                         else to_char(l.response_size_bytes / 1048576, 'fm999990.0') || ' MB'
                       end                                                 as size_label
                     , l.content_type                                      as content_type
                     , l.error_code                                        as error_code
                  from arw_execution_log_vw l
                 where l.execution_id = :P210_EXECUTION_ID
                ```
            pageItemsToSubmit: [
                P210_EXECUTION_ID
            ]
        }
        layout {
            sequence: 10
            parentRegion: @responseSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                arw-plain
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--noBorders
                t-Report--rowHighlightOff
            ]
        }
        heading {
            type: none
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: This endpoint has not been sent yet -- press Send to execute it from the database.
        }

        column STATUS_LABEL (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: <div class="arw-chips"><span class="arw-chip arw-chip--#STATUS_CLASS#">#STATUS_LABEL# #STATUS_TEXT#</span>{if ERROR_CODE/}<span class="arw-chip arw-chip--error arw-mono">#ERROR_CODE#</span>{endif/}<span class="arw-chip">#ELAPSED_MS# ms</span>{if SIZE_LABEL/}<span class="arw-chip">#SIZE_LABEL#</span>{endif/}{if CONTENT_TYPE/}<span class="arw-chip">#CONTENT_TYPE#</span>{endif/}<span class="arw-chip arw-chip--info">Executed from the database</span></div>
            }
        )

        column STATUS_TEXT (
            type: hidden
            layout {
                sequence: 20
            }
        )

        column STATUS_CLASS (
            type: hidden
            layout {
                sequence: 30
            }
        )

        column ELAPSED_MS (
            type: hidden
            layout {
                sequence: 40
            }
        )

        column SIZE_LABEL (
            type: hidden
            layout {
                sequence: 50
            }
        )

        column CONTENT_TYPE (
            type: hidden
            layout {
                sequence: 60
            }
        )

        column ERROR_CODE (
            type: hidden
            layout {
                sequence: 70
            }
        )

    )

    region responseBodyDC (
        advanced {
            htmlDomId: responseBodyDC
        }
        name: Response Body
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                declare
                  lc_max_chars                              constant pls_integer := 500000;
                  l_body                                    clob;
                  l_binary_yn                               arw_executions.response_is_binary_yn%type;
                  l_content_type                            varchar2(255 char);
                  l_file_url                                varchar2(4000 char);
                  l_download_url                            varchar2(4000 char);
                  l_preview                                 varchar2(32767 char);
                  l_lang                                    varchar2(20 char);
                begin
                  if :P210_EXECUTION_ID is null then
                    return null;
                  end if;

                  select case
                           when x.response_body_clob is json
                           then json_serialize(x.response_body_clob returning clob pretty)
                           else x.response_body_clob
                         end                                                 as body_text
                       , x.response_is_binary_yn                             as response_is_binary_yn
                       , case
                           when x.response_body_clob is json                   then 'json'
                           when dbms_lob.substr(x.response_body_clob, 1, 1) = '<' then 'markup'
                           else 'none'
                         end                                                 as lang
                    into l_body
                       , l_binary_yn
                       , l_lang
                    from arw_executions x
                   where x.execution_id = :P210_EXECUTION_ID;

                  if l_binary_yn = 'Y' then
                    -- A file (image, audio, video, PDF...): preview it inline, always offer the download
                    select l.content_type                                   as content_type
                      into l_content_type
                      from arw_execution_log_vw l
                     where l.execution_id = :P210_EXECUTION_ID;

                    l_file_url     := apex_page.get_url(
                                          p_page        => 210
                                        , p_request     => 'RESPONSE_FILE'
                                        , p_items       => 'P210_EXECUTION_ID'
                                        , p_values      => :P210_EXECUTION_ID
                                      );
                    l_download_url := apex_page.get_url(
                                          p_page        => 210
                                        , p_request     => 'RESPONSE_DOWNLOAD'
                                        , p_items       => 'P210_EXECUTION_ID'
                                        , p_values      => :P210_EXECUTION_ID
                                      );

                    l_preview := case
                                   when l_content_type like 'image/%'
                                   then '<img class="arw-media" src="' || apex_escape.html_attribute(l_file_url) || '" alt="Response image">'
                                   when l_content_type like 'audio/%' or l_content_type = 'application/ogg'
                                   then '<audio class="arw-media" controls src="' || apex_escape.html_attribute(l_file_url) || '"></audio>'
                                   when l_content_type like 'video/%'
                                   then '<video class="arw-media" controls src="' || apex_escape.html_attribute(l_file_url) || '"></video>'
                                   when l_content_type = 'application/pdf'
                                   then '<iframe class="arw-media arw-media--doc" title="Response PDF" src="' || apex_escape.html_attribute(l_file_url) || '"></iframe>'
                                 end;

                    return '<div class="arw-file">'
                        || l_preview
                        || '<p><a href="' || apex_escape.html_attribute(l_download_url) || '">Download file</a>'
                        || ' <span class="arw-muted arw-mono">' || apex_escape.html(coalesce(l_content_type, 'unknown type')) || '</span></p>'
                        || '</div>';
                  elsif l_body is null or dbms_lob.getlength(l_body) = 0 then
                    l_body := '[empty response body]';
                  elsif dbms_lob.getlength(l_body) > lc_max_chars then
                    l_body := substr(l_body, 1, lc_max_chars)
                           || chr(10) || '... [truncated -- showing the first ' || lc_max_chars || ' characters]';
                  end if;

                  -- arw-code.js adds the Copy button and the syntax colors
                  return '<pre class="arw-code arw-code--response" data-lang="' || l_lang || '">'
                      || apex_escape.html_clob(p_string => l_body)
                      || '</pre>';
                exception
                  when no_data_found then
                    return null;
                end;
                ```
            pageItemsToSubmit: [
                P210_EXECUTION_ID
            ]
        }
        layout {
            sequence: 20
            parentRegion: @responseSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region responseFooterCR (
        advanced {
            htmlDomId: responseFooterCR
        }
        name: Data Profile
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_profile as (
                  select arw_discover_api.current_profile_id(
                             p_endpoint_id => :P210_ENDPOINT_ID
                         )                                                 as data_profile_id
                    from dual
                )
                , w_count as (
                  select count(1)                                          as column_count
                    from w_profile           w
                    join arw_profile_columns pc on pc.data_profile_id = w.data_profile_id
                   where pc.parent_column_id is null
                     and pc.active_yn = 'Y'
                )
                select case
                         when c.column_count > 0
                         then 'Data profile: ' || c.column_count || ' columns from the last successful JSON response -- used by the REST Data Source in the Code tab'
                         when :P210_EXECUTION_ID is not null
                         then 'No data profile yet -- it is derived from the first successful JSON response'
                       end                                                 as profile_note
                  from w_count c
                ```
            pageItemsToSubmit: [
                P210_ENDPOINT_ID
                P210_EXECUTION_ID
            ]
        }
        layout {
            sequence: 30
            parentRegion: @responseSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
            cssClasses: [
                arw-plain
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--noBorders
                t-Report--rowHighlightOff
            ]
        }
        heading {
            type: none
        }
        pagination {
            type: rowRangesXToYNoPagination
        }

        column PROFILE_NOTE (
            type: plainText
            heading {
                heading: Data profile
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: <span class="arw-response-footer">#PROFILE_NOTE#</span>
            }
        )

    )

