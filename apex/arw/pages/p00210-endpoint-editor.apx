    // =========================================================================
    // Computations (before regions: after the form has been initialized)
    // =========================================================================

    computation compute-environment-id (
        itemName: P210_ENVIRONMENT_ID
        execution {
            sequence: 10
            point: beforeRegions
        }
        computation {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                arw_environments_api.resolve_environment_id(
                    p_collection_id                 => :P210_COLLECTION_ID
                  , p_environment_name              => :ARW_ENV_NAME
                )
                ```
        }
    )

    computation compute-execution-id (
        itemName: P210_EXECUTION_ID
        execution {
            sequence: 20
            point: beforeRegions
        }
        computation {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select s.last_execution_id                                 as last_execution_id
                  from arw_endpoint_summary_vw s
                 where s.endpoint_id = :P210_ENDPOINT_ID
                ```
        }
    )

    computation compute-data-profile-id (
        itemName: P210_DATA_PROFILE_ID
        execution {
            sequence: 30
            point: beforeRegions
        }
        computation {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                arw_discover_api.current_profile_id(
                    p_endpoint_id                   => :P210_ENDPOINT_ID
                )
                ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P210_ENDPOINT_ID
        }
    )

    computation compute-target-profile-id (
        itemName: P210_TARGET_PROFILE_ID
        execution {
            sequence: 40
            point: beforeRegions
        }
        computation {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                arw_target_profiles_api.default_profile_id
                ```
        }
        serverSideCondition {
            type: itemIsNull
            item: P210_TARGET_PROFILE_ID
        }
    )

    computation compute-artifact-type (
        itemName: P210_ARTIFACT_TYPE
        execution {
            sequence: 50
            point: beforeRegions
        }
        computation {
            type: staticValue
            staticValue: plsql_package
        }
        serverSideCondition {
            type: itemIsNull
            item: P210_ARTIFACT_TYPE
        }
    )

    computation compute-bundle-types (
        itemName: P210_BUNDLE_TYPES
        execution {
            sequence: 60
            point: beforeRegions
        }
        computation {
            type: staticValue
            staticValue: apexlang_rds:apexlang_install_script:apexlang_ai_tool
        }
        serverSideCondition {
            type: itemIsNull
            item: P210_BUNDLE_TYPES
        }
    )

    // =========================================================================
    // Dynamic actions
    // =========================================================================

    dynamicAction send-request (
        name: Send Request
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: #SEND, #ADD_SAMPLE
        }

        action execute-endpoint (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      :P210_ACTION_ERROR := null;
                      :P210_SAMPLE_ID    := null;

                      :P210_EXECUTION_ID := arw_exec_api.execute_endpoint(
                                                p_endpoint_id         => :P210_ENDPOINT_ID
                                              , p_environment_id      => :P210_ENVIRONMENT_ID
                                            );
                      :P210_SAMPLE_ID := arw_discover_api.save_sample(
                                             p_execution_id           => :P210_EXECUTION_ID
                                         );
                    exception
                      when others then
                        :P210_ACTION_ERROR := case
                                                when sqlcode between -20999 and -20000
                                                then regexp_replace(
                                                         regexp_replace(dbms_utility.format_error_stack, chr(10) || 'ORA-[0-9]+: .*$', null, 1, 1, 'n')
                                                       , '^ORA-[0-9]+: '
                                                     )
                                                else 'The request could not be sent. See the debug log for details.'
                                              end;
                        apex_debug.error(
                            p_message                 => 'Send failed for endpoint %s: %s'
                          , p0                        => :P210_ENDPOINT_ID
                          , p1                        => sqlerrm
                        );

                        -- A refused call is still recorded as an execution: show the latest one.
                        select max(s.last_execution_id)
                          into :P210_EXECUTION_ID
                          from arw_endpoint_summary_vw s
                         where s.endpoint_id = :P210_ENDPOINT_ID;
                    end;
                    ```
                itemsToSubmit: [
                    P210_ENDPOINT_ID
                    P210_ENVIRONMENT_ID
                ]
                itemsToReturn: [
                    P210_EXECUTION_ID
                    P210_SAMPLE_ID
                    P210_ACTION_ERROR
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-response-status (
            action: refresh
            affectedElements {
                selectionType: region
                region: @responseChipsCR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action refresh-response-body (
            action: refresh
            affectedElements {
                selectionType: region
                region: @responseBodyDC
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action refresh-response-footer (
            action: refresh
            affectedElements {
                selectionType: region
                region: @responseFooterCR
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action show-response-tab (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    arw.endpointEditor.afterSend();
                    ```
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

    )

    dynamicAction derive-profile (
        name: Derive Data Profile
        execution {
            sequence: 20
        }
        when {
            event: click
            selectionType: button
            button: @DERIVE_PROFILE
        }

        action derive-data-profile (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      :P210_ACTION_ERROR := null;

                      :P210_DATA_PROFILE_ID := arw_discover_api.derive_profile(
                                                   p_endpoint_id      => :P210_ENDPOINT_ID
                                               );
                    exception
                      when others then
                        :P210_ACTION_ERROR := case
                                                when sqlcode between -20999 and -20000
                                                then regexp_replace(
                                                         regexp_replace(dbms_utility.format_error_stack, chr(10) || 'ORA-[0-9]+: .*$', null, 1, 1, 'n')
                                                       , '^ORA-[0-9]+: '
                                                     )
                                                else 'The data profile could not be derived. See the debug log for details.'
                                              end;
                        apex_debug.error(
                            p_message                 => 'Derive profile failed for endpoint %s: %s'
                          , p0                        => :P210_ENDPOINT_ID
                          , p1                        => sqlerrm
                        );
                    end;
                    ```
                itemsToSubmit: [
                    P210_ENDPOINT_ID
                ]
                itemsToReturn: [
                    P210_DATA_PROFILE_ID
                    P210_ACTION_ERROR
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-profile-header (
            action: refresh
            affectedElements {
                selectionType: region
                region: @profileHeaderCR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action refresh-profile-columns (
            action: refresh
            affectedElements {
                selectionType: region
                region: @profileColumnsCR
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action refresh-profile-notes (
            action: refresh
            affectedElements {
                selectionType: region
                region: @profileNotesCR
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

        action refresh-code-after-derive (
            action: refresh
            affectedElements {
                selectionType: region
                region: @codeDC
            }
            execution {
                sequence: 50
                fireOnInit: false
            }
        )

        action show-profile (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    arw.endpointEditor.afterDerive();
                    ```
            }
            execution {
                sequence: 60
                fireOnInit: false
            }
        )

    )

    dynamicAction accept-profile (
        name: Accept Profile
        execution {
            sequence: 30
        }
        when {
            event: click
            selectionType: button
            button: @ACCEPT_PROFILE
        }

        action accept-data-profile (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    begin
                      :P210_ACTION_ERROR := null;

                      arw_discover_api.accept_profile(
                          p_data_profile_id                 => :P210_DATA_PROFILE_ID
                      );
                    exception
                      when others then
                        :P210_ACTION_ERROR := case
                                                when sqlcode between -20999 and -20000
                                                then regexp_replace(
                                                         regexp_replace(dbms_utility.format_error_stack, chr(10) || 'ORA-[0-9]+: .*$', null, 1, 1, 'n')
                                                       , '^ORA-[0-9]+: '
                                                     )
                                                else 'The data profile could not be accepted. See the debug log for details.'
                                              end;
                        apex_debug.error(
                            p_message                 => 'Accept profile failed for profile %s: %s'
                          , p0                        => :P210_DATA_PROFILE_ID
                          , p1                        => sqlerrm
                        );
                    end;
                    ```
                itemsToSubmit: [
                    P210_DATA_PROFILE_ID
                ]
                itemsToReturn: [
                    P210_ACTION_ERROR
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-profile-status (
            action: refresh
            affectedElements {
                selectionType: region
                region: @profileHeaderCR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action refresh-code-after-accept (
            action: refresh
            affectedElements {
                selectionType: region
                region: @codeDC
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

        action confirm-accept (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    arw.endpointEditor.afterAccept();
                    ```
            }
            execution {
                sequence: 40
                fireOnInit: false
            }
        )

    )

