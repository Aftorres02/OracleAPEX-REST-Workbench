                htmlExpression: <div class="arw-chips"><span class="arw-chip">Runtime: #RUNTIME_TARGET_CODE#</span>{if TRACE_MODE_CODE/}<span class="arw-chip">Tracing: #TRACE_MODE_CODE#</span><span class="arw-chip">Audit: #AUDIT_LABEL#</span>{endif/}{if !TRACE_MODE_CODE/}<span class="arw-chip arw-chip--warn">No target profile</span>{endif/}</div>
            }
