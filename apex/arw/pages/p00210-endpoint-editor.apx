    region artifactListCR (
        advanced {
            htmlDomId: artifactListCR
        }
        name: Artifacts
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_artifacts as (
                  select 'label'           as row_kind, null              as artifact_type_code, 'PASTE'             as artifact_label, null as divided_yn, 10  as sort_key from dual union all
                  select 'item'            as row_kind, 'plsql_package'   as artifact_type_code, '_api package'      as artifact_label, null as divided_yn, 20  as sort_key from dual union all
                  select 'item'            as row_kind, 'plsql_block'     as artifact_type_code, 'Anonymous block'   as artifact_label, null as divided_yn, 30  as sort_key from dual union all
                  select 'item'            as row_kind, 'json_table'      as artifact_type_code, 'json_table'        as artifact_label, null as divided_yn, 40  as sort_key from dual union all
                  select 'item'            as row_kind, 'table_ddl'       as artifact_type_code, 'Target table DDL'  as artifact_label, null as divided_yn, 50  as sort_key from dual union all
                  select 'item'            as row_kind, 'curl'            as artifact_type_code, 'cURL'              as artifact_label, null as divided_yn, 60  as sort_key from dual union all
                  select 'label'           as row_kind, null              as artifact_type_code, 'INSTALL (.apx)'    as artifact_label, 'Y'  as divided_yn, 70  as sort_key from dual union all
                  select 'item'            as row_kind, 'apexlang_rds'    as artifact_type_code, 'restDataSource'    as artifact_label, null as divided_yn, 80  as sort_key from dual union all
                  select 'item'            as row_kind, 'apexlang_install_script' as artifact_type_code, 'installScript' as artifact_label, null as divided_yn, 90 as sort_key from dual union all
                  select 'item'            as row_kind, 'apexlang_ai_tool' as artifact_type_code, 'aiAgent tool'     as artifact_label, null as divided_yn, 100 as sort_key from dual union all
                  select 'item'            as row_kind, 'apexlang_automation' as artifact_type_code, 'automation'    as artifact_label, null as divided_yn, 110 as sort_key from dual
                )
                select a.row_kind                                          as row_kind
                     , a.artifact_type_code                                as artifact_type_code
                     , a.artifact_label                                    as artifact_label
                     , a.divided_yn                                        as divided_yn
                     , case
                         when a.artifact_type_code = :P210_ARTIFACT_TYPE then 'Y'
                       end                                                 as active_yn
                  from w_artifacts a
                 order by a.sort_key
                ```
            pageItemsToSubmit: [
                P210_ARTIFACT_TYPE
            ]
        }
        layout {
            sequence: 10
            parentRegion: @codeSR
            slot: SUB_REGIONS
            columnSpan: 3
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
