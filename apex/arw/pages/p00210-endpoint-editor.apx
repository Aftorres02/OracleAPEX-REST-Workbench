    // =========================================================================
    // Processes
    // =========================================================================

    process download-bundle (
        name: Download APX Bundle
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_bundle                                  clob;
                  l_blob                                    blob;
                  l_file_name                               varchar2(400 char);
                begin
                  l_bundle := arw_codegen_api.build_apx_bundle(
                                  p_endpoint_id                 => :P210_ENDPOINT_ID
                                , p_artifact_type_codes         => :P210_BUNDLE_TYPES
                                , p_target_profile_id           => :P210_TARGET_PROFILE_ID
                              );
                  l_file_name := replace(
                                     arw_codegen_api.bundle_file_name(p_endpoint_id => :P210_ENDPOINT_ID)
                                   , '"'
                                 );
                  l_blob := apex_util.clob_to_blob(
                                p_clob                        => coalesce(l_bundle, to_clob(' '))
                              , p_charset                     => 'AL32UTF8'
                            );

                  sys.htp.init;
                  sys.owa_util.mime_header('text/plain', false, 'UTF-8');
                  sys.htp.p('Content-Length: ' || sys.dbms_lob.getlength(l_blob));
                  sys.htp.p('Content-Disposition: attachment; filename="' || l_file_name || '"');
                  sys.owa_util.http_header_close;
                  sys.wpg_docload.download_file(l_blob);

                  apex_application.stop_apex_engine;
                end;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'DOWNLOAD' and :P210_ENDPOINT_ID is not null
                ```
        }
    )

    process initialize-endpoint-form (
        name: Initialize Endpoint Form
        type: formInitialization
        formRegion: @endpointForm
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process create-endpoint (
        name: Create Endpoint
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                :P210_ENDPOINT_ID := arw_endpoint_api.create_endpoint(
                                         p_collection_id          => :P210_COLLECTION_ID
                                       , p_name                   => :P210_NAME
                                       , p_http_method            => :P210_HTTP_METHOD
                                       , p_url_path               => :P210_URL_PATH
                                       , p_credential_id          => :P210_CREDENTIAL_ID
                                       , p_timeout_secs           => :P210_TIMEOUT_SECS
                                       , p_runtime_target_code    => :P210_RUNTIME_TARGET_CODE
                                       , p_engine_code            => :P210_ENGINE_CODE
                                     );
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Endpoint created.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'CREATE'
                ```
        }
    )

    process save-endpoint (
        name: Save Endpoint
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_endpoint_api.update_endpoint(
                    p_endpoint_id                   => :P210_ENDPOINT_ID
                  , p_name                          => :P210_NAME
                  , p_http_method                   => :P210_HTTP_METHOD
                  , p_url_path                      => :P210_URL_PATH
                  , p_credential_id                 => :P210_CREDENTIAL_ID
                  , p_timeout_secs                  => :P210_TIMEOUT_SECS
                  , p_runtime_target_code           => :P210_RUNTIME_TARGET_CODE
                  , p_engine_code                   => :P210_ENGINE_CODE
                );
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Endpoint saved.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('SAVE', 'SAVE_AUTH')
                ```
        }
    )

    process delete-endpoint (
        name: Delete Endpoint
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_endpoint_api.deactivate_endpoint(
                    p_endpoint_id                   => :P210_ENDPOINT_ID
                );
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Endpoint deleted.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'DELETE'
                ```
        }
    )

    process save-body (
        name: Save Body
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_endpoint_api.set_body(
                    p_endpoint_id                   => :P210_ENDPOINT_ID
                  , p_content_type                  => coalesce(:P210_CONTENT_TYPE, 'application/json')
                  , p_body_template                 => :P210_BODY_TEMPLATE
                );
                ```
        }
        execution {
            sequence: 40
        }
        successMessage {
            successMessage: Body saved.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'SAVE_BODY'
                ```
        }
    )

    process remove-body (
        name: Remove Body
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_endpoint_api.remove_body(
                    p_endpoint_id                   => :P210_ENDPOINT_ID
                );

                :P210_CONTENT_TYPE  := null;
                :P210_BODY_TEMPLATE := null;
                ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Body removed.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'REMOVE_BODY'
                ```
        }
    )

    process save-headers (
        name: Save Headers
        type: executeCode
        editableRegion: @headersIG
        source {
            plsqlCode:
                ```plsql
                declare
                  lc_mask                                   constant varchar2(8 char) := '********';
                  l_header_value                            arw_endpoint_headers.header_value%type := :HEADER_VALUE;
                begin
                  case :APEX$ROW_STATUS
                    when 'C' then
                      :HEADER_ID := arw_endpoint_api.add_header(
                                        p_endpoint_id             => :P210_ENDPOINT_ID
                                      , p_header_name             => :HEADER_NAME
                                      , p_header_value            => l_header_value
                                      , p_is_sensitive_yn         => coalesce(:IS_SENSITIVE_YN, 'N')
                                    );
                    when 'U' then
                      -- A masked sensitive value comes back unchanged: keep the stored secret.
                      if l_header_value = lc_mask then
                        select h.header_value
                          into l_header_value
                          from arw_endpoint_headers h
                         where h.header_id = :HEADER_ID;
                      end if;

                      arw_endpoint_api.update_header(
                          p_header_id                     => :HEADER_ID
                        , p_header_name                   => :HEADER_NAME
                        , p_header_value                  => l_header_value
                        , p_is_sensitive_yn               => coalesce(:IS_SENSITIVE_YN, 'N')
                      );
                    when 'D' then
                      arw_endpoint_api.remove_header(
                          p_header_id                     => :HEADER_ID
                      );
                  end case;
                end;
                ```
        }
        execution {
            sequence: 60
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APEX$ROW_STATUS in ('C', 'U', 'D')
                ```
        }
    )

    process save-params (
        name: Save Params
        type: executeCode
        editableRegion: @paramsIG
        source {
            plsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    :PARAM_ID := arw_endpoint_api.add_param(
                                     p_endpoint_id                => :P210_ENDPOINT_ID
                                   , p_param_kind_code            => :PARAM_KIND_CODE
                                   , p_param_name                 => :PARAM_NAME
                                   , p_param_value                => :PARAM_VALUE
                                   , p_data_type_code             => coalesce(:DATA_TYPE_CODE, 'varchar2')
                                   , p_is_required_yn             => coalesce(:IS_REQUIRED_YN, 'N')
                                 );
                  when 'U' then
                    arw_endpoint_api.update_param(
                        p_param_id                        => :PARAM_ID
                      , p_param_kind_code                 => :PARAM_KIND_CODE
                      , p_param_name                      => :PARAM_NAME
                      , p_param_value                     => :PARAM_VALUE
                      , p_data_type_code                  => coalesce(:DATA_TYPE_CODE, 'varchar2')
                      , p_is_required_yn                  => coalesce(:IS_REQUIRED_YN, 'N')
                    );
                  when 'D' then
                    arw_endpoint_api.remove_param(
                        p_param_id                        => :PARAM_ID
                    );
                end case;
                ```
        }
        execution {
            sequence: 70
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APEX$ROW_STATUS in ('C', 'U', 'D')
                ```
        }
    )

    // =========================================================================
    // Branches
    // =========================================================================

    branch go-to-endpoints (
        name: Go To Endpoints
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 200
                items: {
                    P200_COLLECTION_ID: &P210_COLLECTION_ID.
                }
                clearCache: 200
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'DELETE'
                ```
        }
    )

    branch back-to-editor (
        name: Back To Editor
        execution {
            sequence: 20
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 210
                items: {
                    P210_ENDPOINT_ID: &P210_ENDPOINT_ID.
                }
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('CREATE', 'SAVE', 'SAVE_AUTH', 'SAVE_BODY', 'REMOVE_BODY')
                ```
        }
    )

)
