                ```sql
                select e.runtime_target_code                               as runtime_target_code
                     , tp.trace_mode_code                                  as trace_mode_code
                     , case tp.audit_enabled_yn
                         when 'Y' then 'yes'
                         when 'N' then 'no'
                       end                                                 as audit_label
                  from arw_endpoints                       e
                  left join arw_target_profiles           tp on tp.target_profile_id = coalesce(
                                                                    to_number(:P210_TARGET_PROFILE_ID)
                                                                  , arw_target_profiles_api.default_profile_id
                                                                )
                                                             and tp.active_yn = 'Y'
                 where e.endpoint_id = :P210_ENDPOINT_ID
                ```
