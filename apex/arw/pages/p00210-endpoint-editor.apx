    region profileNotesCR (
        advanced {
            htmlDomId: profileNotesCR
        }
        name: Profile Notes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with w_notes as (
                  select 'mask'                                            as note_kind
                       , c.column_name || ' ' || to_char(unistr('\2014'))
                         || ' formatMask: ' || c.format_mask               as note_text
                       , c.sequence_num                                    as sort_key
                    from arw_profile_columns c
                   where c.data_profile_id = :P210_DATA_PROFILE_ID
                     and c.active_yn = 'Y'
                     and c.format_mask is not null
                  union all
                  select 'warn'                                            as note_kind
                       , c.column_name || ' ' || c.observation_note        as note_text
                       , 100000 + c.sequence_num                           as sort_key
                    from arw_profile_columns c
                   where c.data_profile_id = :P210_DATA_PROFILE_ID
                     and c.active_yn = 'Y'
                     and c.observation_note is not null
                )
                select n.note_kind                                         as note_kind
                     , n.note_text                                         as note_text
                  from w_notes n
                 order by n.sort_key
                ```
            pageItemsToSubmit: [
                P210_DATA_PROFILE_ID
            ]
        }
        layout {
            sequence: 30
            parentRegion: @profileSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
            cssClasses: [
                arw-plain
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--noBorders
                t-Report--rowHighlightOff
            ]
        }
        heading {
            type: none
        }
        pagination {
            type: rowRangesXToYNoPagination
        }
        messages {
            whenNoDataFound: No format masks or observations.
        }

