            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @endpointForm
            column: AUTH_KEY_LOCATION_CODE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: header
        }
    )

    // =========================================================================
    // Items: Body
    // =========================================================================

    pageItem P210_CONTENT_TYPE (
        type: textField
        label {
            label: Content Type
            alignment: left
        }
        layout {
            sequence: 10
            region: @bodySR
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 200
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select b.content_type                                      as content_type
                  from arw_request_bodies b
                 where b.endpoint_id = :P210_ENDPOINT_ID
                   and b.active_yn = 'Y'
                ```
            used: onlyWhenSessionStateIsNull
        }
        default {
            type: static
            staticValue: application/json
        }
    )

    pageItem P210_BODY_TEMPLATE (
        type: textarea
        label {
            label: Body Template
            alignment: left
        }
        layout {
            sequence: 20
            region: @bodySR
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 120
            height: 18
        }
        advanced {
            cssClasses: [
                arw-mono
            ]
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select b.body_template                                     as body_template
                  from arw_request_bodies b
                 where b.endpoint_id = :P210_ENDPOINT_ID
                   and b.active_yn = 'Y'
                ```
            used: onlyWhenSessionStateIsNull
        }
        sessionState {
            dataType: clob
        }
        help {
            inlineHelpText: Request body sent with POST / PUT / PATCH -- {{variables}} are resolved from the environment
        }
    )

    // =========================================================================
    // Items: Code
    // =========================================================================

    // =========================================================================
    // Items: {params} -- hidden page state
    // =========================================================================

    pageItem P210_ENVIRONMENT_ID (
        type: hidden
        layout {
            sequence: 10
            region: @paramsSR
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: UI state only: set by the Environment selector through itemsToReturn. Send never trusts it -- it resolves the environment from the collection and ARW_ENV_NAME, and arw_exec_api rejects an environment of another collection.
        }
    )

    pageItem P210_EXECUTION_ID (
        type: hidden
        layout {
            sequence: 20
            region: @paramsSR
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: UI state only: the last execution of this request, set by the compute-execution-id computation and the execute-request process.
        }
    )

    pageItem P210_ARTIFACT_TYPE (
        type: hidden
        layout {
            sequence: 50
            region: @paramsSR
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: Same-page dynamic-action ownership: this hidden item is updated after render via setValue (Code tab list) and is used only as UI state, so checksum-based SSP would block the intended flow.
        }
    )

    pageItem P210_ACTION_ERROR (
        type: hidden
        layout {
            sequence: 60
            region: @paramsSR
            slot: regionBody
        }
        settings {
            valueProtected: false
        }
        security {
            sessionStateProtection: unrestricted
        }
        comments {
            comments: UI state only: the error text of the last Send, set by the execute-request process and shown once by the page-load JavaScript.
        }
    )

    // =========================================================================
    // Buttons
    // =========================================================================

    button SEND (
        buttonName: SEND
        advanced {
            htmlDomId: SEND
        }
        label: Send
        layout {
            sequence: 10
            region: @requestSR
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button DELETE (
        buttonName: DELETE
        advanced {
            htmlDomId: DELETE
        }
        label: Delete
        layout {
            sequence: 30
            region: @requestSR
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P210_ENDPOINT_ID
        }
    )

    button SAVE (
        buttonName: SAVE
        advanced {
            htmlDomId: SAVE
        }
        label: Save
        layout {
            sequence: 20
            region: @requestSR
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button DOWNLOAD (
        buttonName: DOWNLOAD
        advanced {
            htmlDomId: DOWNLOAD
        }
        label: Download REST Data Source (.apx)
        layout {
            sequence: 10
            region: @codeFooterSR
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 210
                request: DOWNLOAD
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    // =========================================================================
    // Computations (before regions: after the form has been initialized)
    // =========================================================================

    computation compute-environment-id (
        itemName: P210_ENVIRONMENT_ID
        execution {
            sequence: 10
            point: beforeRegions
        }
        computation {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                arw_environments_api.resolve_environment_id(
                    p_collection_id                 => :P210_COLLECTION_ID
                  , p_environment_name              => :ARW_ENV_NAME
                )
                ```
        }
    )

    computation compute-environment-name (
        itemName: P210_ENV_NAME
        execution {
            sequence: 15
            point: beforeRegions
        }
        computation {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select v.name                                              as environment_name
                  from arw_environments v
                 where v.environment_id = :P210_ENVIRONMENT_ID
                ```
        }
    )

    computation compute-execution-id (
        itemName: P210_EXECUTION_ID
        execution {
            sequence: 20
            point: beforeRegions
        }
        computation {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select s.last_execution_id                                 as last_execution_id
                  from arw_endpoint_summary_vw s
                 where s.endpoint_id = :P210_ENDPOINT_ID
                ```
        }
    )

    computation compute-artifact-type (
        itemName: P210_ARTIFACT_TYPE
        execution {
            sequence: 50
            point: beforeRegions
        }
        computation {
            type: staticValue
            staticValue: plsql_package
        }
        serverSideCondition {
            type: itemIsNull
            item: P210_ARTIFACT_TYPE
        }
    )

    // =========================================================================
    // Dynamic actions
    // =========================================================================

    dynamicAction change-environment (
        name: Change Environment
        execution {
            sequence: 15
        }
        when {
            event: change
            selectionType: items
            items: P210_ENV_NAME
        }

        action set-active-environment (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    :ARW_ENV_NAME        := :P210_ENV_NAME;
                    :P210_ENVIRONMENT_ID := arw_environments_api.resolve_environment_id(
                                                p_collection_id     => :P210_COLLECTION_ID
                                              , p_environment_name  => :ARW_ENV_NAME
                                            );
                    ```
                itemsToSubmit: [
                    P210_ENV_NAME
                    P210_COLLECTION_ID
                ]
                itemsToReturn: [
                    P210_ENVIRONMENT_ID
                ]
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action refresh-url-preview (
            action: refresh
            affectedElements {
                selectionType: region
                region: @requestBarCR
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

    )

    dynamicAction toggle-auth-fields (
        name: Toggle Auth Fields
        execution {
            sequence: 50
        }
        when {
            event: change
            selectionType: items
            items: P210_AUTH_TYPE_CODE
        }

        action show-auth-fields (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    arw.endpointEditor.toggleAuthFields();
                    ```
            }
            execution {
                sequence: 10
                fireOnInit: true
            }
        )

    )

    dynamicAction select-artifact (
        name: Select Artifact
        execution {
            sequence: 60
            eventScope: dynamic
            staticContainer: #artifactListCR
        }
        when {
            event: click
            selectionType: jQuerySelector
            jquerySelector: .arw-artifact
        }

        action set-artifact-type (
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.getAttribute('data-artifact')
            }
            affectedElements {
                selectionType: items
                items: P210_ARTIFACT_TYPE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action highlight-artifact (
            action: executeJsCode
            settings {
                jsCode:
                    ```javascript
                    arw.endpointEditor.markArtifactActive(this.triggeringElement);
                    ```
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action refresh-code (
            action: refresh
            affectedElements {
                selectionType: region
                region: @codeDC
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

    // =========================================================================
    // Validations (Auth tab: before any process saves the request)
    // =========================================================================

    validation basic-username-required (
        name: Basic Auth Needs Username
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P210_AUTH_USERNAME
        }
        error {
            errorMessage: Basic auth needs a username.
            associatedItem: @P210_AUTH_USERNAME
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('SAVE', 'SEND') and :P210_AUTH_TYPE_CODE = 'basic'
                ```
        }
    )

    validation bearer-token-required (
        name: Bearer Auth Needs Token
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P210_AUTH_TOKEN
        }
        error {
            errorMessage: Bearer auth needs a token (it can be a {{variable}}).
            associatedItem: @P210_AUTH_TOKEN
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('SAVE', 'SEND') and :P210_AUTH_TYPE_CODE = 'bearer'
                ```
        }
    )

    validation api-key-name-required (
        name: API Key Needs Name
        execution {
            sequence: 30
        }
        validation {
            type: itemIsNotNull
            item: P210_AUTH_KEY_NAME
        }
        error {
            errorMessage: An API key needs a name, e.g. x-api-key.
            associatedItem: @P210_AUTH_KEY_NAME
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('SAVE', 'SEND') and :P210_AUTH_TYPE_CODE = 'api_key'
                ```
        }
    )

    validation api-key-value-required (
        name: API Key Needs Value
        execution {
            sequence: 40
        }
        validation {
            type: itemIsNotNull
            item: P210_AUTH_KEY_VALUE
        }
        error {
            errorMessage: An API key needs a value (it can be a {{variable}}).
            associatedItem: @P210_AUTH_KEY_VALUE
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('SAVE', 'SEND') and :P210_AUTH_TYPE_CODE = 'api_key'
                ```
        }
    )

    // =========================================================================
    // Processes
    // =========================================================================

    process download-bundle (
        name: Download REST Data Source
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_bundle                                  clob;
                  l_blob                                    blob;
                  l_file_name                               varchar2(400 char);
                begin
                  l_bundle := arw_codegen_api.build_apx_bundle(
                                  p_endpoint_id                 => :P210_ENDPOINT_ID
                                , p_artifact_type_codes         => 'apexlang_rds'
                              );
                  l_file_name := replace(
                                     arw_codegen_api.bundle_file_name(p_endpoint_id => :P210_ENDPOINT_ID)
                                   , '"'
                                 );
                  l_blob := apex_util.clob_to_blob(
                                p_clob                        => coalesce(l_bundle, to_clob(' '))
                              , p_charset                     => 'AL32UTF8'
                            );

                  sys.htp.init;
                  sys.owa_util.mime_header('text/plain', false, 'UTF-8');
                  sys.htp.p('Content-Length: ' || sys.dbms_lob.getlength(l_blob));
                  sys.htp.p('Content-Disposition: attachment; filename="' || l_file_name || '"');
                  sys.owa_util.http_header_close;
                  sys.wpg_docload.download_file(l_blob);

                  apex_application.stop_apex_engine;
                end;
                ```
        }
        execution {
            sequence: 5
            point: beforeHeader
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'DOWNLOAD' and :P210_ENDPOINT_ID is not null
                ```
        }
    )

    process response-file (
        name: Serve Response File
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_blob                                    blob;
                  l_content_type                            varchar2(255 char);
                  l_file_name                               varchar2(200 char);
                begin
                  select x.response_body_blob                               as response_body_blob
                       , coalesce(l.content_type, 'application/octet-stream') as content_type
                       , 'response-' || x.execution_id
                         || case
                              when l.content_type = 'image/png'                 then '.png'
                              when l.content_type in ('image/jpeg', 'image/jpg') then '.jpg'
                              when l.content_type = 'image/gif'                 then '.gif'
                              when l.content_type = 'image/svg+xml'             then '.svg'
                              when l.content_type = 'image/webp'                then '.webp'
                              when l.content_type = 'audio/mpeg'                then '.mp3'
                              when l.content_type in ('audio/ogg', 'application/ogg') then '.ogg'
                              when l.content_type = 'video/mp4'                 then '.mp4'
                              when l.content_type = 'application/pdf'           then '.pdf'
                              else '.bin'
                            end                                             as file_name
                    into l_blob
                       , l_content_type
                       , l_file_name
                    from arw_executions                      x
                    join arw_execution_log_vw                l on l.execution_id = x.execution_id
                   where x.execution_id = :P210_EXECUTION_ID
                     and x.response_is_binary_yn = 'Y';

                  sys.htp.init;
                  sys.owa_util.mime_header(l_content_type, false);
                  sys.htp.p('Content-Length: ' || sys.dbms_lob.getlength(l_blob));
                  sys.htp.p('Content-Disposition: '
                            || case when :REQUEST = 'RESPONSE_DOWNLOAD' then 'attachment' else 'inline' end
                            || '; filename="' || l_file_name || '"');
                  sys.owa_util.http_header_close;
                  sys.wpg_docload.download_file(l_blob);

                  apex_application.stop_apex_engine;
                end;
                ```
        }
        execution {
            sequence: 6
            point: beforeHeader
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('RESPONSE_FILE', 'RESPONSE_DOWNLOAD') and :P210_EXECUTION_ID is not null
                ```
        }
    )

    process initialize-endpoint-form (
        name: Initialize Endpoint Form
        type: formInitialization
        formRegion: @endpointForm
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process save-endpoint (
        name: Save Endpoint
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P210_ENDPOINT_ID is null then
                  -- New request: no collection chosen means Drafts
                  :P210_COLLECTION_ID := coalesce(:P210_COLLECTION_ID, arw_collections_api.drafts_collection_id);
                  :P210_ENDPOINT_ID   := arw_endpoint_api.create_endpoint(
                                             p_collection_id          => :P210_COLLECTION_ID
                                           , p_name                   => :P210_NAME
                                           , p_http_method            => :P210_HTTP_METHOD
                                           , p_url_path               => :P210_URL_PATH
                                           , p_timeout_secs           => :P210_TIMEOUT_SECS
                                           , p_runtime_target_code    => :P210_RUNTIME_TARGET_CODE
                                           , p_engine_code            => :P210_ENGINE_CODE
                                         );
                else
                  arw_endpoint_api.update_endpoint(
                      p_endpoint_id                   => :P210_ENDPOINT_ID
                    , p_name                          => :P210_NAME
                    , p_http_method                   => :P210_HTTP_METHOD
                    , p_url_path                      => :P210_URL_PATH
                    , p_credential_id                 => null
                    , p_timeout_secs                  => :P210_TIMEOUT_SECS
                    , p_runtime_target_code           => :P210_RUNTIME_TARGET_CODE
                    , p_engine_code                   => :P210_ENGINE_CODE
                    , p_collection_id                 => :P210_COLLECTION_ID
                  );
                end if;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Saved.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('SAVE', 'SEND')
                ```
        }
    )

    process delete-endpoint (
        name: Delete Endpoint
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_endpoint_api.deactivate_endpoint(
                    p_endpoint_id                   => :P210_ENDPOINT_ID
                );
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Endpoint deleted.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'DELETE'
                ```
        }
    )

    process save-auth (
        name: Save Auth
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_endpoint_api.set_auth(
                    p_endpoint_id                   => :P210_ENDPOINT_ID
                  , p_auth_type_code                => :P210_AUTH_TYPE_CODE
                  , p_auth_username                 => :P210_AUTH_USERNAME
                  , p_auth_password                 => :P210_AUTH_PASSWORD
                  , p_auth_token                    => :P210_AUTH_TOKEN
                  , p_auth_key_name                 => :P210_AUTH_KEY_NAME
                  , p_auth_key_value                => :P210_AUTH_KEY_VALUE
                  , p_auth_key_location_code        => :P210_AUTH_KEY_LOCATION_CODE
                );
                ```
        }
        execution {
            sequence: 15
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('SAVE', 'SEND')
                ```
        }
    )

    process save-body (
        name: Save Body
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_endpoint_api.set_body(
                    p_endpoint_id                   => :P210_ENDPOINT_ID
                  , p_content_type                  => coalesce(:P210_CONTENT_TYPE, 'application/json')
                  , p_body_template                 => :P210_BODY_TEMPLATE
                );
                ```
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('SAVE', 'SEND')
                ```
        }
    )

    process save-headers (
        name: Save Headers
        type: executeCode
        editableRegion: @headersIG
        source {
            plsqlCode:
                ```plsql
                declare
                  lc_mask                                   constant varchar2(8 char) := '********';
                  l_header_value                            arw_endpoint_headers.header_value%type := :HEADER_VALUE;
                begin
                  case :APEX$ROW_STATUS
                    when 'C' then
                      :HEADER_ID := arw_endpoint_api.add_header(
                                        p_endpoint_id             => :P210_ENDPOINT_ID
                                      , p_header_name             => :HEADER_NAME
                                      , p_header_value            => l_header_value
                                      , p_is_sensitive_yn         => coalesce(:IS_SENSITIVE_YN, 'N')
                                    );
                    when 'U' then
                      -- A masked sensitive value comes back unchanged: keep the stored secret.
                      if l_header_value = lc_mask then
                        select h.header_value
                          into l_header_value
                          from arw_endpoint_headers h
                         where h.header_id = :HEADER_ID;
                      end if;

                      arw_endpoint_api.update_header(
                          p_header_id                     => :HEADER_ID
                        , p_header_name                   => :HEADER_NAME
                        , p_header_value                  => l_header_value
                        , p_is_sensitive_yn               => coalesce(:IS_SENSITIVE_YN, 'N')
                      );
                    when 'D' then
                      arw_endpoint_api.remove_header(
                          p_header_id                     => :HEADER_ID
                      );
                  end case;
                end;
                ```
        }
        execution {
            sequence: 60
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APEX$ROW_STATUS in ('C', 'U', 'D') and :REQUEST in ('SAVE', 'SEND')
                ```
        }
    )

    process save-params (
        name: Save Params
        type: executeCode
        editableRegion: @paramsIG
        source {
            plsqlCode:
                ```plsql
                case :APEX$ROW_STATUS
                  when 'C' then
                    :PARAM_ID := arw_endpoint_api.add_param(
                                     p_endpoint_id                => :P210_ENDPOINT_ID
                                   , p_param_kind_code            => :PARAM_KIND_CODE
                                   , p_param_name                 => :PARAM_NAME
                                   , p_param_value                => :PARAM_VALUE
                                   , p_data_type_code             => coalesce(:DATA_TYPE_CODE, 'varchar2')
                                   , p_is_required_yn             => coalesce(:IS_REQUIRED_YN, 'N')
                                 );
                  when 'U' then
                    arw_endpoint_api.update_param(
                        p_param_id                        => :PARAM_ID
                      , p_param_kind_code                 => :PARAM_KIND_CODE
                      , p_param_name                      => :PARAM_NAME
                      , p_param_value                     => :PARAM_VALUE
                      , p_data_type_code                  => coalesce(:DATA_TYPE_CODE, 'varchar2')
                      , p_is_required_yn                  => coalesce(:IS_REQUIRED_YN, 'N')
                    );
                  when 'D' then
                    arw_endpoint_api.remove_param(
                        p_param_id                        => :PARAM_ID
                    );
                end case;
                ```
        }
        execution {
            sequence: 70
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :APEX$ROW_STATUS in ('C', 'U', 'D') and :REQUEST in ('SAVE', 'SEND')
                ```
        }
    )

    process execute-request (
        name: Execute Request
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                declare
                  l_data_profile_id                         arw_data_profiles.data_profile_id%type;
                begin
                  -- The execution is logged in an autonomous transaction that
                  -- references the endpoint: commit what Save just wrote first,
                  -- or a request created by this same Send would deadlock.
                  commit;

                  :P210_ACTION_ERROR   := null;
                  :P210_ENVIRONMENT_ID := arw_environments_api.resolve_environment_id(
                                              p_collection_id       => :P210_COLLECTION_ID
                                            , p_environment_name    => :ARW_ENV_NAME
                                          );
                  :P210_EXECUTION_ID   := arw_exec_api.execute_endpoint(
                                              p_endpoint_id         => :P210_ENDPOINT_ID
                                            , p_environment_id      => :P210_ENVIRONMENT_ID
                                          );

                  -- The data profile follows the last successful JSON response.
                  -- A response that can't be profiled never fails the Send.
                  begin
                    savepoint before_auto_profile;
                    l_data_profile_id := arw_discover_api.auto_profile(
                                             p_execution_id         => :P210_EXECUTION_ID
                                         );
                  exception
                    when others then
                      rollback to before_auto_profile;
                      apex_debug.warn(
                          p_message                 => 'Automatic data profile skipped for execution %s: %s'
                        , p0                        => :P210_EXECUTION_ID
                        , p1                        => sqlerrm
                      );
                  end;
                exception
                  when others then
                    -- Keep the saved request; report the refusal or failure on reload
                    :P210_ACTION_ERROR := case
                                            when sqlcode between -20999 and -20000
                                            then regexp_replace(
                                                     regexp_replace(dbms_utility.format_error_stack, chr(10) || 'ORA-[0-9]+: .*$', null, 1, 1, 'n')
                                                   , '^ORA-[0-9]+: '
                                                 )
                                            else 'The request could not be sent. See the debug log for details.'
                                          end;
                    apex_debug.error(
                        p_message                     => 'Send failed for endpoint %s: %s'
                      , p0                            => :P210_ENDPOINT_ID
                      , p1                            => sqlerrm
                    );
                end;
                ```
        }
        execution {
            sequence: 80
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'SEND' and :P210_ENDPOINT_ID is not null
                ```
        }
    )

    process clear-action-error (
        name: Clear Action Error
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                -- Shown once by the page-load JavaScript; don't repeat it on the next visit
                :P210_ACTION_ERROR := null;
                ```
        }
        execution {
            sequence: 10
            point: afterFooter
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P210_ACTION_ERROR
        }
    )

    // =========================================================================
    // Branches
    // =========================================================================

    branch go-to-endpoints (
        name: Go To Endpoints
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 200
                items: {
                    P200_COLLECTION_ID: &P210_COLLECTION_ID.
                }
                clearCache: 200
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'DELETE'
                ```
        }
    )

    branch back-to-editor (
        name: Back To Editor
        execution {
            sequence: 20
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 210
                items: {
                    P210_ENDPOINT_ID: &P210_ENDPOINT_ID.
                }
            }
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('SAVE', 'SEND')
                ```
        }
    )

)
