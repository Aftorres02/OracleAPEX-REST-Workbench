    region codeDC (
        advanced {
            htmlDomId: codeDC
        }
        name: Generated Code
        type: dynamicContent
        source {
            language: plsql
            plsqlFunctionBody:
                ```plsql
                declare
                  l_code                                    clob;
                  l_message                                 varchar2(4000 char);
                begin
                  if :P210_ENDPOINT_ID is null or :P210_ARTIFACT_TYPE is null then
                    return null;
                  end if;

                  l_code := arw_codegen_api.get_artifact(
                                p_endpoint_id                 => :P210_ENDPOINT_ID
                              , p_artifact_type_code          => :P210_ARTIFACT_TYPE
                            );

                  if l_code is null or dbms_lob.getlength(l_code) = 0 then
                    return '<p class="arw-code-empty">Nothing was generated for this artifact.</p>';
                  end if;

                  -- arw-code.js adds the Copy button and the syntax colors
                  return '<pre class="arw-code arw-code--source" data-lang="'
                      || case
                           when :P210_ARTIFACT_TYPE = 'curl'           then 'bash'
                           when :P210_ARTIFACT_TYPE like 'apexlang%'   then 'apexlang'
                           else 'plsql'
                         end
                      || '">'
                      || apex_escape.html_clob(p_string => l_code)
                      || '</pre>';
                exception
                  when others then
                    l_message := case
                                   when sqlcode between -20999 and -20000
                                   then regexp_replace(
                                            regexp_replace(dbms_utility.format_error_stack, chr(10) || 'ORA-[0-9]+: .*$', null, 1, 1, 'n')
                                          , '^ORA-[0-9]+: '
                                        )
                                   else 'The code could not be generated. See the debug log for details.'
                                 end;
                    apex_debug.error(
                        p_message                     => 'Code generation failed for endpoint %s / %s: %s'
                      , p0                            => :P210_ENDPOINT_ID
                      , p1                            => :P210_ARTIFACT_TYPE
                      , p2                            => sqlerrm
                    );
                    return '<div class="arw-banner--warn">' || apex_escape.html(p_string => l_message) || '</div>';
                end;
                ```
            pageItemsToSubmit: [
                P210_ENDPOINT_ID
                P210_ARTIFACT_TYPE
            ]
        }
        layout {
            sequence: 20
            parentRegion: @codePanelSR
            slot: SUB_REGIONS
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

