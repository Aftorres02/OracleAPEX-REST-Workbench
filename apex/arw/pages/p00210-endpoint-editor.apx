    region profileColumnsCR (
        advanced {
            htmlDomId: profileColumnsCR
        }
        name: Profile Columns
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.column_id                                         as column_id
                     , c.column_name                                       as column_name
                     , substr(sys_connect_by_path(c.path_expression, '[*].'), 5) as path_label
                     , arw_discover_api.data_type_label(
                           p_data_type_code => c.data_type_code
                       )                                                   as data_type_label
                     , c.max_observed_length                               as max_observed_length
                     , c.is_nullable_yn                                    as is_nullable_yn
                     , c.is_primary_key_yn                                 as is_primary_key_yn
                  from arw_profile_columns c
                 where c.active_yn = 'Y'
                 start with c.data_profile_id = :P210_DATA_PROFILE_ID
                        and c.parent_column_id is null
                        and c.active_yn = 'Y'
                 connect by prior c.column_id = c.parent_column_id
                 order siblings by c.sequence_num
                                 , c.column_id
                ```
            pageItemsToSubmit: [
                P210_DATA_PROFILE_ID
            ]
