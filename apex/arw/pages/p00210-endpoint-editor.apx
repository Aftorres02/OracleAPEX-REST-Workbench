                heading: Samples
            }
            layout {
                sequence: 10
            }
            columnFormatting {
                htmlExpression: <span class="arw-response-footer">{if SAMPLE_SAVED_YN/}Sample saved &mdash; {endif/}{if !SAMPLE_SAVED_YN/}{if EXECUTED_YN/}Last response not saved as a sample (only successful JSON responses are) &mdash; {endif/}{endif/}#SAMPLE_COUNT# collected for this endpoint</span>
