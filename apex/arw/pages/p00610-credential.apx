page 610 (
    name: Credential
    alias: CREDENTIAL
    title: Credential
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 720
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Credential metadata (name, auth type, Web Credential static ID). The secret itself is only ever handed to the APEX credential store through Create Web Credential -- it is never saved in session state or in an ARW table. Creating it again with the same static ID rotates the secret.
    }

    region credentialSR (
        advanced {
            htmlDomId: credentialSR
        }
        name: Credential
        type: staticContent
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    region webCredentialSR (
        advanced {
            htmlDomId: webCredentialSR
        }
        name: Create Web Credential in APEX
        title: Create Web Credential in APEX
        type: staticContent
        source {
            htmlCode:
                ```html
                <p class="arw-muted">basic: user name + password &middot; bearer: token (header defaults to Authorization) &middot; api_key_header / api_key_query: name + key. Other auth types are configured in Shared Components &gt; Web Credentials.</p>
                ```
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region buttonsSR (
        advanced {
            htmlDomId: buttonsSR
        }
        name: Buttons
        type: staticContent
        layout {
            sequence: 30
            slot: REGION_POSITION_03
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    pageItem P610_CREDENTIAL_ID (
        type: hidden
        layout {
            sequence: 10
            region: @credentialSR
            slot: regionBody
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P610_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 20
            region: @credentialSR
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        default {
            type: item
            item: P610_STATIC_ID
        }
    )

    pageItem P610_AUTH_TYPE_CODE (
        type: selectList
        label {
            label: Auth Type
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Basic;basic,Bearer token;bearer,API key in header;api_key_header,API key in query string;api_key_query,OAuth2 client credentials;oauth2_client_credentials,OAuth2 password;oauth2_password,OCI native;oci,Mutual TLS;mtls,AWS SigV4;sigv4,Signed JWT;jwt_signed
            displayNullValue: true
            nullDisplayValue: &SELECT_LABEL.
        }
        layout {
            sequence: 30
            region: @credentialSR
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
    )

    pageItem P610_STATIC_ID (
        type: textField
        label {
            label: Web Credential Static ID
            alignment: left
        }
        layout {
            sequence: 40
            region: @credentialSR
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 40
            valuePlaceholder: ACME_BEARER
        }
        validation {
            maxLength: 255
        }
        advanced {
            cssClasses: [
                arw-mono
            ]
        }
        help {
            inlineHelpText: Static ID of the APEX Web Credential that holds the secret
        }
    )

    pageItem P610_WC_STATUS (
        type: displayOnly
        label {
            label: Web Credential
            alignment: left
        }
        settings {
            sendOnPageSubmit: false
            format: plainText
        }
        layout {
            sequence: 50
            region: @credentialSR
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                case
                  when :P610_STATIC_ID is null then 'No static ID yet'
                  else case arw_credentials_api.web_credential_exists(p_static_id => :P610_STATIC_ID)
                         when 'Y' then 'Exists in this workspace'
                         when 'N' then 'Not found -- create it below'
                         else 'Unknown (no APEX session)'
                       end
                end
                ```
            used: always
        }
    )

    pageItem P610_WC_CLIENT_ID (
        type: textField
        label {
            label: User name / header or parameter name
            alignment: left
        }
        layout {
            sequence: 10
            region: @webCredentialSR
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 40
            valuePlaceholder: Authorization
        }
        validation {
            maxLength: 255
        }
        help {
            inlineHelpText: basic: user name; bearer: optional (defaults to Authorization); api_key_header / api_key_query: header or parameter name
        }
    )

    pageItem P610_WC_CLIENT_SECRET (
        type: password
        label {
            label: Secret (password, token or key)
            alignment: left
        }
        layout {
            sequence: 20
            region: @webCredentialSR
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 40
        }
        validation {
            maxLength: 4000
        }
        advanced {
            customAttributes: autocomplete="new-password"
        }
        sessionState {
            storage: request
        }
        help {
            inlineHelpText: Handed straight to the APEX credential store; never saved in session state
        }
    )

    pageItem P610_WC_ALLOWED_URL (
        type: textField
        label {
            label: Allowed URL
            alignment: left
        }
        layout {
            sequence: 30
            region: @webCredentialSR
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            valuePlaceholder: https://api.example.com/
        }
        validation {
            maxLength: 1000
        }
        help {
            inlineHelpText: The credential is only sent to URLs starting with this value
        }
    )

    button CREATE_WEB_CREDENTIAL (
        buttonName: CREATE_WEB_CREDENTIAL
        advanced {
            htmlDomId: CREATE_WEB_CREDENTIAL
        }
        label: Create Web Credential
        layout {
            sequence: 10
            region: @webCredentialSR
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
    )

    button CANCEL (
        buttonName: CANCEL
        advanced {
            htmlDomId: CANCEL
        }
        label: Cancel
        layout {
            sequence: 10
            region: @buttonsSR
            slot: CLOSE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button DELETE (
        buttonName: DELETE
        advanced {
            htmlDomId: DELETE
        }
        label: Delete
        layout {
            sequence: 20
            region: @buttonsSR
            slot: DELETE
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P610_CREDENTIAL_ID
        }
    )

    button SAVE (
        buttonName: SAVE
        advanced {
            htmlDomId: SAVE
        }
        label: Save
        layout {
            sequence: 30
            region: @buttonsSR
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P610_CREDENTIAL_ID
        }
    )

    button CREATE (
        buttonName: CREATE
        advanced {
            htmlDomId: CREATE
        }
        label: Create
        layout {
            sequence: 40
            region: @buttonsSR
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
        }
        serverSideCondition {
            type: itemIsNull
            item: P610_CREDENTIAL_ID
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @CANCEL
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation static-id-required (
        name: Static ID Required For Web Credential
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P610_STATIC_ID
        }
        error {
            errorMessage: Enter the Web Credential static ID first.
            associatedItem: @P610_STATIC_ID
        }
        serverSideCondition {
            whenButtonPressed: @CREATE_WEB_CREDENTIAL
        }
    )

    validation secret-required (
        name: Secret Required For Web Credential
        execution {
            sequence: 20
        }
        validation {
            type: itemIsNotNull
            item: P610_WC_CLIENT_SECRET
        }
        error {
            errorMessage: Enter the secret (password, token or key).
            associatedItem: @P610_WC_CLIENT_SECRET
        }
        serverSideCondition {
            whenButtonPressed: @CREATE_WEB_CREDENTIAL
        }
    )

    process load-credential (
        name: Load Credential
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                select c.name                                              as name
                     , c.auth_type_code                                    as auth_type_code
                     , c.apex_credential_static_id                         as apex_credential_static_id
                  into :P610_NAME
                     , :P610_AUTH_TYPE_CODE
                     , :P610_STATIC_ID
                  from arw_credentials c
                 where c.credential_id = :P610_CREDENTIAL_ID;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P610_CREDENTIAL_ID
        }
    )

    process save-credential (
        name: Save Credential Metadata
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                if :P610_CREDENTIAL_ID is null then
                  :P610_CREDENTIAL_ID := arw_credentials_api.create_credential(
                                             p_name                        => :P610_NAME
                                           , p_auth_type_code              => :P610_AUTH_TYPE_CODE
                                           , p_apex_credential_static_id   => :P610_STATIC_ID
                                         );
                else
                  arw_credentials_api.update_credential(
                      p_credential_id               => :P610_CREDENTIAL_ID
                    , p_name                        => :P610_NAME
                    , p_auth_type_code              => :P610_AUTH_TYPE_CODE
                    , p_apex_credential_static_id   => :P610_STATIC_ID
                  );
                end if;
                ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Credential saved.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('CREATE', 'SAVE', 'CREATE_WEB_CREDENTIAL')
                ```
        }
    )

    process delete-credential (
        name: Delete Credential
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_credentials_api.deactivate_credential(
                    p_credential_id               => :P610_CREDENTIAL_ID
                );
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Credential deleted.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'DELETE'
                ```
        }
    )

    process create-web-credential (
        name: Create Web Credential
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                arw_credentials_api.create_web_credential(
                    p_static_id                   => :P610_STATIC_ID
                  , p_name                        => :P610_NAME
                  , p_auth_type_code              => :P610_AUTH_TYPE_CODE
                  , p_client_id                   => :P610_WC_CLIENT_ID
                  , p_client_secret               => :P610_WC_CLIENT_SECRET
                  , p_allowed_url                 => :P610_WC_ALLOWED_URL
                );
                ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Credential saved and Web Credential created in APEX.
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST = 'CREATE_WEB_CREDENTIAL'
                ```
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: expression
            language: plsql
            plsqlExpression:
                ```plsql
                :REQUEST in ('CREATE', 'SAVE', 'DELETE', 'CREATE_WEB_CREDENTIAL')
                ```
        }
    )

)
