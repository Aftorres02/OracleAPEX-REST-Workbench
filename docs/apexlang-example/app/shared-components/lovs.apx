lov boolean (
    name: BOOLEAN
    source {
        location: staticValues
    }

    entry false (
        sequence: 2
        display: No
        return: FALSE
    )

    entry true (
        sequence: 1
        display: Yes
        return: TRUE
    )

)

lov owners (
    name: OWNERS
    source {
        tableName: ALL_USERS
    }
    columnMapping {
        return: USERNAME
        display: USERNAME
        defaultSort: USERNAME
    }
)

