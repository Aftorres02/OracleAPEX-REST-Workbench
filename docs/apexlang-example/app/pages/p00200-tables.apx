page 200 (
    name: Tables
    alias: TABLES
    title: Tables
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }
    help {
        helpText: Browse all_tables rows for the target instance. Sort, filter, and save report views using the interactive report actions.
    }

    region breadcrumb-bar (
        name: Tables
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 5
            slot: REGION_POSITION_01
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region tables (
        name: Tables
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select owner,
                       table_name,
                       tablespace_name,
                       num_rows,
                       last_analyzed,
                       partitioned
                  from all_tables
                ```
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: No data found.
        }

        column OWNER (
            type: plainText
            heading {
                heading: Owner
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )

        column TABLE_NAME (
            type: plainText
            heading {
                heading: Table Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )

        column TABLESPACE_NAME (
            type: plainText
            heading {
                heading: Tablespace Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )

        column NUM_ROWS (
            type: plainText
            heading {
                heading: Num Rows
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990
            }
            source {
                dataType: NUMBER
            }
        )

        column LAST_ANALYZED (
            type: plainText
            heading {
                heading: Last Analyzed
            }
            layout {
                sequence: 50
            }
            appearance {
                formatMask: DD-MON-YYYY
            }
            source {
                dataType: DATE
            }
        )

        column PARTITIONED (
            type: plainText
            heading {
                heading: Partitioned
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )

    )

)
